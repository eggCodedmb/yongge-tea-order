import { defineStore } from 'pinia'

export interface UserInfo {
	nickname: string;
	avatar: string;
	phone: string;
	points: number;
}

// 解析用户信息，确保返回纯对象
function parseUserInfo(): UserInfo | null {
	try {
		const stored = uni.getStorageSync('user_info')
		if (stored == null || stored === '') return null
		// 使用 JSON 序列化/反序列化确保是纯对象
		return JSON.parse(JSON.stringify(stored)) as UserInfo
	} catch (e) {
		console.error('解析用户信息失败:', e)
		return null
	}
}

export const useUserStore = defineStore('user', {
	state: () => ({
		userInfo: parseUserInfo(),
		token: uni.getStorageSync('access_token') as string || ''
	}),
	actions: {
		setUserInfo(info: UserInfo) {
			// 确保赋值的是纯对象
			this.userInfo = {
				nickname: info.nickname,
				avatar: info.avatar,
				phone: info.phone,
				points: info.points
			} as UserInfo
			uni.setStorageSync('user_info', this.userInfo)
		},
		setToken(token: string) {
			this.token = token
			uni.setStorageSync('access_token', token)
		},
		logout() {
			this.userInfo = null
			this.token = ''
			uni.removeStorageSync('user_info')
			uni.removeStorageSync('access_token')
		}
	}
})
