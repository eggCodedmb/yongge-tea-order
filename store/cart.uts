import { defineStore } from 'pinia'

export interface CartItem {
	id: number;
	name: string;
	price: number;
	quantity: number;
	specs: string[];
	toppings: string[];
	totalPrice: number;
	image: string;
}

export const useCartStore = defineStore('cart', {
	state: () => ({
		items: [] as CartItem[]
	}),
	getters: {
		totalCount(): number {
			return this.items.reduce((total, item) => total + item.quantity, 0)
		},
		totalAmount(): number {
			const total = this.items.reduce((total, item) => total + item.totalPrice, 0)
			return Math.round(total * 100) / 100
		}
	},
	actions: {
		addToCart(item: CartItem) {
			const index = this.items.findIndex(i => 
				i.id === item.id && 
				JSON.stringify(i.specs) === JSON.stringify(item.specs) && 
				JSON.stringify(i.toppings) === JSON.stringify(item.toppings)
			)
			if (index > -1) {
				this.items[index].quantity += item.quantity
				this.items[index].totalPrice = Math.round((this.items[index].totalPrice + item.totalPrice) * 100) / 100
			} else {
				this.items.push(item)
			}
		},
		increaseQuantity(index: number) {
			if (this.items[index]) {
				const unitPrice = this.items[index].totalPrice / this.items[index].quantity
				this.items[index].quantity += 1
				this.items[index].totalPrice = Math.round((this.items[index].quantity * unitPrice) * 100) / 100
			}
		},
		decreaseQuantity(index: number) {
			if (this.items[index]) {
				if (this.items[index].quantity > 1) {
					const unitPrice = this.items[index].totalPrice / this.items[index].quantity
					this.items[index].quantity -= 1
					this.items[index].totalPrice = Math.round((this.items[index].quantity * unitPrice) * 100) / 100
				} else {
					this.removeFromCart(index)
				}
			}
		},
		removeFromCart(index: number) {
			this.items.splice(index, 1)
		},
		clearCart() {
			this.items = []
		}
	}
})
