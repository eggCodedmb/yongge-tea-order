import { defineStore } from 'pinia'
import { request } from '@/utils/request.uts'
import { useAppStore } from './app.uts'

export interface CartItem {
	id: number; // 商品ID (goods_id)
	cartId: number; // 购物车记录ID (主键)
	name: string;
	price: number; // 单价 (含规格)
	quantity: number;
	specs: string[];
	spec_ids: number[]; // 规格ID列表
	toppings: string[];
	totalPrice: number;
	image: string;
	selected: boolean;
}

// 跨门店商品校验结果
interface CheckResultItem {
	original_id: number;
	original_name: string;
	matched_id: number | null;
	matched_name: string | null;
	available: boolean;
	stock: number;
	price: number;
	reason?: string;
}

// 购物车转移结果
export interface TransferResult {
	transferred: CartItem[];  // 成功转移的商品
	removed: CartItem[];      // 被移除的商品（不可用）
	updated: CartItem[];      // ID/价格更新的商品
}

// 解析购物车存储数据，确保返回纯对象
function parseCartItems(): CartItem[] {
	try {
		const stored = uni.getStorageSync('cart_items') as string || '[]'
		const parsed = JSON.parse(stored) as any[]
		// 使用 JSON 序列化/反序列化确保是纯对象
		return JSON.parse(JSON.stringify(parsed)).map((item: any): CartItem => {
			// 兼容性处理：将旧的 specIds 转换为 spec_ids
			if (item['specIds'] != null && item['spec_ids'] == null) {
				item['spec_ids'] = item['specIds']
			}
			// 确保数组字段不为空
			if (item['specs'] == null) item['specs'] = [] as string[]
			if (item['spec_ids'] == null) item['spec_ids'] = [] as number[]
			if (item['toppings'] == null) item['toppings'] = [] as string[]

			return item as CartItem
		})
	} catch (e) {
		console.error('解析购物车数据失败:', e)
		return []
	}
}

export const useCartStore = defineStore('cart', {
	state: () => ({
		items: parseCartItems(),
		loading: false
	}),
	getters: {
		totalCount(): number {
			return this.items.reduce((total, item) => total + item.quantity, 0)
		},
		selectedCount(): number {
			return this.items.filter(i => i.selected).reduce((total, item) => total + item.quantity, 0)
		},
		totalAmount(): number {
			// 如果 items 为空或没有被选中的，直接返回 0
			if (this.items.length === 0) return 0
			const total = this.items.filter(i => i.selected).reduce((total, item) => total + item.totalPrice, 0)
			return Math.round(total * 100) / 100
		}
	},
	actions: {
		saveToStorage() {
			uni.setStorageSync('cart_items', JSON.stringify(this.items))
		},

		async addToCart(item: CartItem) {
			const appStore = useAppStore()
			const storeId = appStore.currentStore?.id
			
			if (storeId == null) {
				uni.showToast({ title: '请先选择门店', icon: 'none' })
				throw new Error('请先选择门店')
			}

			try {
				const reqData = { 
					goods_id: item.id,
					store_id: storeId
				} as UTSJSONObject
				if (item.specs.length > 0) {
					reqData['specs'] = item.specs.join(',')
				}
				
				const res = await request<any>({
					url: '/cart/add',
					method: 'POST',
					data: reqData
				})
				
				if (res.result != null && res.result['id'] != null) {
					const cartId = res.result['id'] as number
					item.selected = true
					
					// 根据 ID 和规格判断是否合并
					const idx = this.items.findIndex(i => i.id === item.id && i.specs.join(',') === item.specs.join(','))
					if (idx > -1) {
						this.items[idx].quantity += item.quantity
						this.items[idx].totalPrice = Math.round((this.items[idx].price * this.items[idx].quantity) * 100) / 100
						this.items[idx].selected = true
						this.items[idx].cartId = cartId
					} else {
						const newItem = { ...item, cartId } as CartItem
						this.items.push(newItem)
					}
					this.saveToStorage()
				}
			} catch (e) {
				console.error('Sync add to cart failed', e)
				throw e
			}
		},
		
		async increaseQuantity(index: number) {
			const item = this.items[index]
			if (item == null) return
			const originalQuantity = item.quantity
			item.quantity += 1
			item.totalPrice = Math.round((item.price * item.quantity) * 100) / 100
			this.saveToStorage()

			try {
				if (item.cartId > 0) {
					const appStore = useAppStore()
					const storeId = appStore.currentStore?.id
					const reqData = { number: item.quantity } as UTSJSONObject
					if (storeId != null) {
						reqData['store_id'] = storeId
					}
					await request<any>({
						url: `/cart/number/${item.cartId}`,
						method: 'PATCH',
						data: reqData
					})
				}
			} catch (e) {
				console.error('Sync increase quantity failed', e)
				// 回滚数量和价格！
				item.quantity = originalQuantity
				item.totalPrice = Math.round((item.price * item.quantity) * 100) / 100
				this.saveToStorage()
			}
		},
		
		async decreaseQuantity(index: number) {
			const item = this.items[index]
			if (item == null) return
			if (item.quantity > 1) {
				item.quantity -= 1
				item.totalPrice = Math.round((item.price * item.quantity) * 100) / 100
				this.saveToStorage()
				try {
					if (item.cartId > 0) {
						await request<any>({
							url: `/cart/number/${item.cartId}`,
							method: 'PATCH',
							data: { number: item.quantity }
						})
					}
				} catch (e) {
					console.error('Sync decrease quantity failed', e)
				}
			} else {
				await this.removeFromCart(index)
			}
		},
		
		async removeFromCart(index: number) {
			const item = this.items[index]
			if (item == null) return
			const cartId = item.cartId
			this.items.splice(index, 1)
			this.saveToStorage()

			try {
				if (cartId > 0) {
					await request<any>({
						url: '/cart/remove',
						method: 'POST',
						data: { ids: [cartId] }
					})
				}
			} catch (e) {
				console.error('Sync remove from cart failed', e)
			}
		},

		async clearCart() {
			const ids = this.items.map(item => item.cartId).filter(id => id > 0)
			this.items = []
			this.saveToStorage()

			if (ids.length > 0) {
				try {
					await request<any>({
						url: '/cart/remove',
						method: 'POST',
						data: { ids: ids }
					})
				} catch (e) {
					console.error('Sync clear cart failed', e)
				}
			}
		},

		async toggleCheck(index: number) {
			const item = this.items[index]
			if (item == null) return
			item.selected = !item.selected
			this.saveToStorage()

			try {
				if (item.cartId > 0) {
					await request<any>({
						url: '/cart/check',
						method: 'PATCH',
						data: { ids: [item.cartId] }
					})
				}
			} catch (e) {
				console.error('Sync toggle check failed', e)
			}
		},

		async toggleAll(isSelect: boolean) {
			this.items.forEach(item => {
				item.selected = isSelect
			})
			this.saveToStorage()

			try {
				await request<any>({
					url: '/cart/selectAll',
					method: 'POST',
					data: { isSelect: isSelect }
				})
			} catch (e) {
				console.error('Sync toggle all failed', e)
			}
		},

		/**
		 * 转移购物车商品到目标门店
		 * 校验商品在目标门店的可用性，更新或移除不可用商品
		 */
		async transferCartToStore(targetStoreId: number): Promise<TransferResult> {
			if (this.items.length === 0) {
				return { transferred: [], removed: [], updated: [] }
			}

			try {
				const res = await request<any>({
					url: '/goods/batch_check',
					method: 'POST',
					data: {
						store_id: targetStoreId,
						items: this.items.map(item => ({
							goods_id: item.id,
							name: item.name
						}))
					}
				})

				const checkResult = res.result as CheckResultItem[]
				const transferred: CartItem[] = []
				const removed: CartItem[] = []
				const updated: CartItem[] = []

				for (const item of this.items) {
					const check = checkResult.find(c => c.original_id === item.id)

					if (check != null && check.available && check.matched_id != null) {
						// 商品在目标门店可用
						const updatedItem = { ...item }

						// 如果ID发生变化（不同门店的同名商品），更新ID和价格
						if (updatedItem.id !== check.matched_id) {
							updatedItem.id = check.matched_id
							updatedItem.price = check.price
							updatedItem.totalPrice = Math.round((check.price * updatedItem.quantity) * 100) / 100
							updated.push(updatedItem)
						}

						transferred.push(updatedItem)
					} else {
						// 商品不可用，移除
						removed.push(item)
					}
				}

				// 更新购物车
				this.items = transferred
				this.saveToStorage()

				return { transferred, removed, updated }
			} catch (e) {
				console.error('购物车转移失败:', e)
				// 失败时清空购物车，避免脏数据
				const removedItems = [...this.items]
				this.items = []
				this.saveToStorage()
				return { transferred: [], removed: removedItems, updated: [] }
			}
		},

		/**
		 * 批量校验商品并将符合条件的加入购物车
		 */
		async addReorderItems(orderItems: any[], targetStoreId: number) {
			if (orderItems.length === 0) return

			uni.showLoading({ title: '正在校验商品...' })
			try {
				const reqItems = orderItems.map((item: any): UTSJSONObject => {
					let nameVal = '未知商品'
					let originalIdVal = 0

					const p = item['product']
					if (p != null) {
						const pObj = p as UTSJSONObject
						if (pObj['goods_name'] != null) {
							nameVal = pObj['goods_name'] as string
						}
						if (pObj['id'] != null) {
							originalIdVal = pObj['id'] as number
						}
					} else {
						if (item['name'] != null) {
							nameVal = item['name'] as string
						}
						if (item['goods_id'] != null) {
							originalIdVal = item['goods_id'] as number
						}
					}

					return {
						goods_id: originalIdVal,
						name: nameVal
					} as UTSJSONObject
				})

				const res = await request<any>({
					url: '/goods/batch_check',
					method: 'POST',
					data: {
						store_id: targetStoreId,
						items: reqItems
					}
				})
				
				uni.hideLoading()
				const checkResult = res.result as CheckResultItem[]
				const addedItems = [] as string[]
				const failedItems = [] as string[]

				for (const item of orderItems) {
					let itemName = '未知商品'
					const p = item['product']
					if (p != null) {
						const pObj = p as UTSJSONObject
						if (pObj['goods_name'] != null) {
							itemName = pObj['goods_name'] as string
						}
					} else if (item['name'] != null) {
						itemName = item['name'] as string
					}

					const check = checkResult.find((c: CheckResultItem): boolean => c.original_name === itemName)

					if (check != null && check.available && check.matched_id != null) {
						let specsArray = [] as string[]
						const itemSpecs = item['specs']
						if (itemSpecs != null) {
							if (Array.isArray(itemSpecs)) {
								specsArray = itemSpecs as string[]
							} else {
								specsArray = (itemSpecs as string).split('/')
							}
						}
						
						let specIdsArray = [] as number[]
						const itemSpecIds = item['spec_ids']
						if (itemSpecIds != null) {
							if (Array.isArray(itemSpecIds)) {
								specIdsArray = itemSpecIds as number[]
							} else {
								specIdsArray = (itemSpecIds as string).split(',').map((id : string) : number => parseInt(id))
							}
						}

						const oldQuantity = item['quantity'] != null ? (item['quantity'] as number) : 1
						const imgVal = (check.image != null && check.image !== '') 
							? check.image 
							: (p != null && (p as UTSJSONObject)['goods_img'] != null ? ((p as UTSJSONObject)['goods_img'] as string) : '')

						const cartItem = {
							id: check.matched_id,
							cartId: 0,
							name: check.matched_name || itemName,
							price: check.price,
							quantity: oldQuantity,
							specs: specsArray,
							spec_ids: specIdsArray,
							toppings: [] as string[],
							totalPrice: check.price * oldQuantity,
							image: imgVal,
							selected: true
						} as CartItem

						// 调用 addToCart 会再次进行后端校验并同步到数据库购物车
						try {
							await this.addToCart(cartItem)
							addedItems.push(itemName)
						} catch (addErr) {
							failedItems.push(itemName)
						}
					} else {
						failedItems.push(itemName)
					}
				}

				if (failedItems.length > 0) {
					if (addedItems.length > 0) {
						uni.showModal({
							title: '部分商品不可用',
							content: `以下商品因无货或不在当前门店未添加：${failedItems.join('、')}`,
							showCancel: false,
							confirmText: '知道了'
						})
					} else {
						uni.showModal({
							title: '商品不可用',
							content: `所选订单的商品在当前门店均不可用或无货。`,
							showCancel: false,
							confirmText: '知道了'
						})
					}
				} else {
					uni.showToast({ title: '已成功添加到购物车', icon: 'none' })
				}

				// 跳转到点单页
				uni.switchTab({
					url: '/pages/menu/menu'
				})

			} catch (e) {
				uni.hideLoading()
				console.error('再来一单校验失败:', e)
				uni.showToast({ title: '校验失败，请稍后再试', icon: 'none' })
			}
		}
	}
})
