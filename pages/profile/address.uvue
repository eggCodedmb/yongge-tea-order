		font-size: 32rpx;
		font-weight: bold;
		color: #333;
		margin-right: 20rpx;
	}

	.user-phone {
		font-size: 28rpx;
		color: #666;
		margin-right: 20rpx;
	}

	.default-badge {
		background-color: #00cc99;
		color: #fff;
		font-size: 20rpx;
		padding: 2rpx 10rpx;
		border-radius: 4rpx;
		margin-right: 10rpx;
	}

	.label-badge {
		background-color: #e6f7f3;
		color: #00cc99;
		font-size: 20rpx;
		padding: 2rpx 10rpx;
		border-radius: 4rpx;
	}

	.address-detail {
		display: flex;
	}

	.detail-text {
		font-size: 26rpx;
		color: #999;
		line-height: 1.4;
	}

	.edit-btn {
		padding: 20rpx;
		margin-left: 20rpx;
	}

	.edit-icon {
		font-size: 36rpx;
		color: #ccc;
	}

	.empty-state {
		display: flex;
