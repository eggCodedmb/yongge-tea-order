<template>
	<view class="page-container">
		<scroll-view class="address-scroll" scroll-y>
			<view v-if="addressStore.addresses.length > 0" class="address-list">
				<view v-for="(item, index) in addressStore.addresses" :key="item.id" class="address-item" @click="handleSelect(item)">
					<view class="item-content">
						<view class="user-info">
							<text class="user-name">{{item.name}}</text>
							<text class="user-phone">{{item.phone}}</text>
							<text v-if="item.isDefault" class="default-badge">默认</text>
							<text v-if="item.label" class="label-badge">{{item.label}}</text>
						</view>
						<view class="address-detail">
							<text class="detail-text">{{item.province}}{{item.city}}{{item.district}} {{item.detail}}</text>
						</view>
					</view>
					<view class="edit-btn" @click.stop="handleEdit(item)">
						<text class="edit-icon">✎</text>
					</view>
				</view>
			</view>
			
			<view v-else class="empty-state">
				<text class="empty-icon">📍</text>
				<text class="empty-text">暂无收货地址</text>
			</view>

			<view style="height: 160rpx;"></view>
		</scroll-view>

		<view class="footer-btn-wrap">
			<button class="add-btn" @click="handleAdd">
				<text class="add-btn-text">+ 添加新地址</text>
			</button>
		</view>
	</view>
</template>

<script setup lang="uts">
	import { onMounted } from 'vue'
	import { useAddressStore, AddressItem } from '@/store/address.uts'

	const addressStore = useAddressStore()

	onMounted(() => {
		addressStore.fetchAddresses()
	})

	function handleAdd() {
		uni.navigateTo({
			url: '/pages/profile/address-edit'
		})
	}

	function handleEdit(item: AddressItem) {
		uni.navigateTo({
			url: `/pages/profile/address-edit?id=${item.id}`
		})
	}

	function handleSelect(item: AddressItem) {
		const pages = getCurrentPages()
		// 检查是否从结算页跳转过来
		if (pages.length > 1) {
			const prevPage = pages[pages.length - 2]
			if (prevPage.route === 'pages/checkout/checkout') {
				addressStore.setSelectedAddressId(item.id)
				uni.navigateBack()
				return
			}
		}
		// 如果不是从结算页来，默认行为可以是编辑或者不执行任何操作
		// 这里我们选择不执行，因为已经有编辑按钮了
	}
</script>

<style>
