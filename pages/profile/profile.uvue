								<view class="progress-fill" :style="{width: userStore.token != '' ? '65%' : '0%'}"></view>
							</view>
							<text class="progress-text">{{userStore.token != '' ? '再积 35 分升级' : '登录查看进度'}}</text>
						</view>
						<view class="asset-grid">
							<view class="asset-col">
								<text class="asset-num">{{userStore.userInfo?.points || 0}}</text>
								<text class="asset-name">积分</text>
							</view>
							<view class="asset-col">
								<text class="asset-num">0</text>
								<text class="asset-name">礼券</text>
							</view>
						</view>
					</view>
				</view>

				<!-- 订单快捷状态 -->
				<view class="module-card">
					<view class="module-title-row" @click="goToOrders">
						<text class="module-main-title">我的订单</text>
						<view style="flex-direction: row; align-items: center;">
							<text class="module-link">全部订单</text>
							<view class="css-arrow-right"></view>
						</view>
					</view>
					<view class="status-flex">
						<view class="status-box" @click="goToOrders(2)">
							<uni-icons type="wallet" size="24" color="#00cc99"></uni-icons>
							<text class="s-label">待付款</text>
						</view>
						<view class="status-box" @click="goToOrders(0)">
							<uni-icons type="shop-filled" size="24" color="#00cc99"></uni-icons>
