					</view>
				</view>

				<!-- 更多服务列表 -->
				<view class="module-card no-padding">
					<view class="list-item" hover-class="item-hover" @click="goToAddress">
						<view class="list-icon-wrap">
							<uni-icons type="location-filled" size="20" color="#00cc99"></uni-icons>
						</view>
						<text class="list-text">收货地址</text>
						<view class="css-arrow-right-large"></view>
					</view>
					<view class="list-item" hover-class="item-hover">
						<view class="list-icon-wrap">
							<uni-icons type="gift" size="20" color="#ff6b6b"></uni-icons>
						</view>
						<text class="list-text">邀请有礼</text>
