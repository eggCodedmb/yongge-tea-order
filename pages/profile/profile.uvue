<template>
	<view class="page-container">
		<scroll-view class="profile-scroll" scroll-y>
			<!-- 顶部品牌背景区 -->
			<view class="brand-header">
				<view class="user-info-row" @click="handleLogin">
					<view class="avatar-wrapper">
						<image :src="userStore.userInfo?.avatar || '/static/logo.png'" class="avatar" mode="aspectFill"></image>
						<view class="edit-badge" v-if="userStore.token != ''" @click.stop="goToProfileEdit">
							<uni-icons type="compose" size="16" color="#fff"></uni-icons>
						</view>
					</view>
					<view class="user-text-meta">
						<text class="user-name">{{userStore.userInfo?.nickname || '登录/注册'}}</text>
						<text class="user-sub">{{userStore.token != '' ? '愿每一杯茶都能温暖你' : '解锁会员特权，尽享美味'}}</text>
					</view>
				</view>
			</view>

			<view class="content-overlap">
				<!-- 会员/资产胶囊卡片 -->
				<view class="member-card-premium">
					<view class="card-top-row">
						<view class="level-info">
							<text class="level-label">V{{userStore.token != '' ? '2' : '0'}} 益友会员</text>
