					</view>
					<view class="list-item" hover-class="item-hover" @click="contactService">
						<view class="list-icon-wrap">
							<uni-icons type="phone" size="20" color="#42a5f5"></uni-icons>
						</view>
						<text class="list-text">在线客服</text>
						<view class="css-arrow-right-large"></view>
					</view>
				</view>

				<!-- 退出登录 -->
				<view class="logout-btn-wrap" v-if="userStore.token != ''" @click="handleLogout">
					<uni-icons type="poweroff" size="18" color="#ff4d4f"></uni-icons>
					<text class="logout-text">退出当前账号</text>
				</view>

				<view class="footer-copy">
					<text class="copy-text">© 勇哥茶饮 点物小程序 v1.0.3</text>
				</view>
			</view>
		</scroll-view>
	</view>
</template>

<script setup lang="uts">
	import { useUserStore } from '@/store/user.uts'
	import { useAppStore } from '@/store/app.uts'
	import { useCartStore } from '@/store/cart.uts'
	import { request } from '@/utils/request.uts'
	import { onShow } from '@dcloudio/uni-app'

	const userStore = useUserStore()
	const cartStore = useCartStore()

	onShow(() => {
		checkSession()
	})

	async function checkSession() {
		if (userStore.token == '') return

		try {
			// 通过请求一个需要权限的接口来校验 token 是否有效
			await request<any>({
				url: '/user/permissions',
				method: 'GET'
			})
		} catch (e) {
			// request 拦截器已经处理了 logout
			console.log('Session check failed, user logged out')
		}
	}

	function handleLogin() {
		if (userStore.token != '') {
			goToProfileEdit()
			return
		}

		uni.login({
			provider: 'weixin',
			success: (res) => {
				const code = res.code
				if (code) {
					performLogin(code)
				}
			},
			fail: (_) => {
				uni.showToast({ title: '获取凭证失败', icon: 'none' })
			}
		})
	}

	async function performLogin(code: string) {
		uni.showLoading({ title: '安全登录中' })
		try {
			const res = await request<any>({
				url: '/user/wxlogin',
				method: 'POST',
				data: {
					code: code,
					userInfo: {
						nick_name: '益友会员',
						avatar: ''
					}
				}
			})

			uni.hideLoading()

			const result = res.result as UTSJSONObject
			const user = result['user'] as UTSJSONObject

			userStore.setUserInfo({
				nickname: user['nick_name'] as string || '益友会员',
				avatar: user['avatar'] as string || '',
				phone: user['phone'] as string || '',
				points: (user['points'] as number || 0)
			})
			userStore.setToken(result['accessToken'] as string)

			uni.showToast({ title: '登录成功', icon: 'success' })
		} catch (e) {
			uni.hideLoading()
			console.error('Login failed', e)
		}
	}

	function handleLogout() {
		uni.showModal({
			title: '提示',
			content: '确定要退出登录吗？',
			success: (res) => {
				if (res.confirm) {
					userStore.logout()
					uni.showToast({ title: '已退出', icon: 'none' })
				}
			}
		})
	}

	function goToProfileEdit() {
		uni.navigateTo({
			url: '/pages/profile/profile-edit'
		})
	}

	function goToOrders(index: number = 0) {
		const appStore = useAppStore()
		appStore.setOrderTabIndex(index)
		uni.switchTab({
			url: '/pages/order/order'
		})
	}

	function goToAddress() {
		uni.navigateTo({
			url: '/pages/profile/address'
		})
	}

	function contactService() {
		uni.showToast({ title: '客服正在赶来...', icon: 'none' })
	}
</script>

