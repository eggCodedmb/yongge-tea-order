<template>
	<view class="page-container">
		<scroll-view class="edit-scroll" scroll-y>
			<!-- 头像区域 - 现代设计 -->
			<view class="avatar-section">
				<view class="avatar-bg-card">
					<!-- 装饰性圆形 -->
					<view class="deco-circle deco-circle-1"></view>
					<view class="deco-circle deco-circle-2"></view>
					<view class="deco-circle deco-circle-3"></view>

					<view class="avatar-content" @click="showAvatarActions">
						<view class="avatar-ring">
							<view class="avatar-inner">
								<image :src="form.avatar || '/static/logo.png'" class="avatar-img" mode="aspectFill"></image>
							</view>
							<view class="camera-badge">
								<uni-icons type="camera-filled" size="18" color="#fff"></uni-icons>
							</view>
						</view>
						<view class="avatar-hint-wrap">
							<uni-icons type="refresh" size="14" color="rgba(255,255,255,0.8)"></uni-icons>
							<text class="avatar-hint">点击更换头像</text>
						</view>
					</view>
				</view>
			</view>

			<!-- 表单区域 - 卡片式设计 -->
			<view class="form-section">
				<view class="form-card">
					<view class="form-header">
						<text class="form-title">基本信息</text>
						<view class="form-title-line"></view>
					</view>

					<view class="form-item" @click="focusNickname">
						<view class="form-item-left">
							<view class="item-icon-wrap item-icon-person">
								<uni-icons type="person-filled" size="18" color="#00cc99"></uni-icons>
							</view>
							<text class="item-label">昵称</text>
						</view>
						<view class="form-item-right">
							<input class="input-field" placeholder="请输入昵称" v-model="form.nickname" maxlength="20" />
							<view class="input-arrow">
								<uni-icons type="right" size="16" color="#ccc"></uni-icons>
							</view>
						</view>
					</view>

					<view class="form-item">
						<view class="form-item-left">
							<view class="item-icon-wrap item-icon-phone">
								<uni-icons type="phone" size="18" color="#42a5f5"></uni-icons>
							</view>
							<text class="item-label">手机号</text>
						</view>
						<view class="form-item-right">
							<text class="phone-value">{{form.phone || '未绑定'}}</text>
							<view class="phone-badge" v-if="form.phone">
								<uni-icons type="checkmarkempty" size="12" color="#00cc99"></uni-icons>
								<text class="badge-text">已绑定</text>
							</view>
						</view>
					</view>
				</view>

				<!-- 安全提示卡片 -->
				<view class="tips-card">
					<view class="tips-icon-wrap">
						<uni-icons type="info" size="20" color="#8a6d00"></uni-icons>
					</view>
					<view class="tips-content">
						<text class="tips-title">温馨提示</text>
						<text class="tips-desc">修改个人信息后，点击下方按钮即可保存更新</text>
					</view>
				</view>
			</view>
		</scroll-view>

		<!-- 底部保存按钮 - 现代设计 -->
		<view class="footer-section">
			<view class="footer-btn-wrap">
				<button class="save-btn" @click="handleSave" :disabled="saving">
					<view class="btn-content">
						<uni-icons v-if="!saving" type="checkmarkempty" size="20" color="#fff"></uni-icons>
						<text class="btn-text">{{saving ? '保存中...' : '保存修改'}}</text>
					</view>
				</button>
			</view>
		</view>
	</view>
</template>

<script setup lang="uts">
	import { ref, reactive, onMounted } from 'vue'
	import { useUserStore } from '@/store/user.uts'
	import { request } from '@/utils/request.uts'

	const userStore = useUserStore()
	const saving = ref(false)

	const form = reactive({
		nickname: '',
		avatar: '',
		phone: ''
	})

	onMounted(() => {
		// 从 userStore 读取当前用户信息
		if (userStore.userInfo) {
			form.nickname = userStore.userInfo.nickname || ''
			form.avatar = userStore.userInfo.avatar || ''
			form.phone = userStore.userInfo.phone || ''
		}
	})

	function focusNickname() {
		// 点击昵称行时聚焦输入框
	}

	function showAvatarActions() {
		uni.showActionSheet({
			itemList: ['选择本地图片'],
			success: (res) => {
				if (res.tapIndex === 0) {
					chooseLocalImage()
				}
			}
		})
	}

	function chooseLocalImage() {
		uni.chooseImage({
			count: 1,
			sizeType: ['compressed'],
			sourceType: ['album', 'camera'],
			success: (res) => {
				const tempFilePaths = res.tempFilePaths as string[]
				if (tempFilePaths.length > 0) {
					form.avatar = tempFilePaths[0]
				}
			},
			fail: (err) => {
				console.error('选择图片失败', err)
				uni.showToast({ title: '选择图片失败', icon: 'none' })
			}
		})
	}

	async function handleSave() {
		if (!form.nickname.trim()) {
			uni.showToast({ title: '请输入昵称', icon: 'none' })
			return
		}

		saving.value = true
		uni.showLoading({ title: '保存中...' })

		try {
			const updateData: UTSJSONObject = {
				nick_name: form.nickname.trim()
			}

			if (form.avatar) {
				updateData['avatar'] = form.avatar
			}

			await request<any>({
				url: '/user/change-user',
				method: 'PATCH',
				data: updateData
			})

			uni.hideLoading()
			saving.value = false

			// 更新本地 store
			userStore.setUserInfo({
				nickname: form.nickname.trim(),
				avatar: form.avatar,
				phone: form.phone,
				points: userStore.userInfo?.points || 0
			})

			uni.showToast({ title: '保存成功', icon: 'success' })
			setTimeout(() => {
				uni.navigateBack()
			}, 1500)
		} catch (e) {
			uni.hideLoading()
			saving.value = false
			console.error('保存失败', e)
		}
	}
</script>

