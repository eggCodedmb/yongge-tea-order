<template>
	<view class="page-wrapper">
		<scroll-view class="container" scroll-y>
			<!-- 外卖配送地址选择 -->
			<view v-if="appStore.orderMode === 'delivery'" class="section card address-section" @click="goToSelectAddress">
				<view v-if="addressStore.selectedAddress" class="address-info">
					<view class="address-main">
						<text class="address-text">{{addressStore.selectedAddress.province}}{{addressStore.selectedAddress.city}}{{addressStore.selectedAddress.district}} {{addressStore.selectedAddress.detail}}</text>
					</view>
					<view class="address-user">
						<text class="user-name">{{addressStore.selectedAddress.name}}</text>
						<text class="user-phone">{{addressStore.selectedAddress.phone}}</text>
					</view>
				</view>
				<view v-else class="address-placeholder">
					<text class="placeholder-text">请选择收货地址</text>
				</view>
				<view class="css-arrow-right-large"></view>
			</view>

			<!-- 门店信息 (自取模式显示) -->
			<view v-if="appStore.orderMode === 'self-pickup'" class="section card">
				<view class="mode-row">
					<text class="mode-label">门店自取</text>
				</view>
				<view class="store-row">
					<text class="store-name">{{appStore.currentStore?.name}}</text>
					<text class="store-address">{{appStore.currentStore?.address}}</text>
				</view>
			</view>

			<!-- 订单明细 -->
			<view class="section card">
				<view class="section-title">
					<text>订单明细</text>
				</view>
				<view v-for="(item, index) in selectedItems" :key="index" class="order-item">
					<view class="item-info">
						<text class="item-name">{{item.name}}</text>
						<text class="item-specs">{{item.specs.join('/')}}</text>
					</view>
					<view class="item-right">
						<text class="item-quantity">x{{item.quantity}}</text>
						<text class="item-price">￥{{item.totalPrice}}</text>
					</view>
				</view>
				<view class="total-row">
					<text class="total-label">合计</text>
					<text class="total-price">￥{{cartStore.totalAmount}}</text>
				</view>
			</view>

			<!-- 备注 -->
			<view class="section card">
				<view class="remark-row">
					<text class="remark-label">备注</text>
					<input class="remark-input" placeholder="请填写您的备注要求" v-model="remark" />
				</view>
			</view>

			<!-- 底部占位 -->
			<view style="height: 180rpx;"></view>
		</scroll-view>

		<!-- 底部结算栏 -->
		<view class="footer-bar">
			<view class="footer-left">
				<text class="footer-total-label">待支付</text>
				<text class="footer-total-price">￥{{cartStore.totalAmount}}</text>
			</view>
			<view class="pay-btn" @click="handlePay">
				<text class="pay-btn-text">立即支付</text>
			</view>
		</view>

		<!-- uni-pay-x 支付组件 -->
		<uni-pay
			ref="uniPayRef"
			return-url="/pages/order/detail"
			@success="onPaySuccess"
			@fail="onPayFail"
			@cancel="onPayCancel"
			@create="onPayCreate"
		/>
	</view>
</template>

<script setup lang="uts">
	import { ref, onMounted, getCurrentInstance, computed } from 'vue'
	import { useAppStore } from '@/store/app.uts'
	import { useCartStore } from '@/store/cart.uts'
	import { useUserStore } from '@/store/user.uts'
	import { useAddressStore } from '@/store/address.uts'
	import { request } from '@/utils/request.uts'

	const appStore = useAppStore()
	const cartStore = useCartStore()
	const userStore = useUserStore()
	const addressStore = useAddressStore()
	const remark = ref('')
	const uniPayRef = ref(null)
	const currentOrderId = ref(0)

	const selectedItems = computed(() : CartItem[] => {
		return cartStore.items.filter(i => i.selected)
	})

	// 获取当前实例用于访问 $refs
	const instance = getCurrentInstance()

	onMounted(() => {
		if (appStore.orderMode === 'delivery') {
			addressStore.fetchAddresses()
		}
	})

	function goToSelectAddress() {
		uni.navigateTo({
			url: '/pages/profile/address'
		})
	}

	/**
	 * 库存预检查 - 在创建订单前检查商品库存是否充足
	 */
	async function checkStock(): Promise<boolean> {
		const selectedItems = cartStore.items.filter(i => i.selected)
		if (selectedItems.length === 0) return false

		try {
			const res = await request<any>({
				url: '/order/check_stock',
				method: 'POST',
				data: {
					items: selectedItems.map(item => ({
						goods_id: item.id,
						quantity: item.quantity,
						name: item.name
					}))
				}
			})

			if (res.result != null && !res.result.all_available) {
				// 找出库存不足的商品
				const unavailableItems = (res.result.items as any[]).filter((i: any) => !i.available)
				const itemNames = unavailableItems.map((i: any) => `${i.name}(库存:${i.stock})`).join('、')

				uni.showModal({
					title: '库存不足',
					content: `以下商品库存不足：${itemNames}，请修改数量后再试`,
					showCancel: false,
					confirmText: '知道了'
				})
				return false
			}

			return true
		} catch (e) {
			console.error('库存检查失败:', e)
			// 检查接口失败时不阻塞，让创建订单接口来判断
			return true
		}
	}

	async function handlePay() {
		if (userStore.token == '') {
			uni.showToast({ title: '请先登录', icon: 'none' })
			return
		}
		
		const selectedItems = cartStore.items.filter(i => i.selected)
		if (selectedItems.length === 0) {
			uni.showToast({ title: '请选择要结算的商品', icon: 'none' })
			return
		}

		// 外卖配送模式下，必须选择地址
		if (appStore.orderMode === 'delivery' && !addressStore.selectedAddress) {
			uni.showToast({ title: '请选择收货地址', icon: 'none' })
			return
		}

		// 库存预检查
		const stockOk = await checkStock()
		if (!stockOk) return

		// --- 完全模拟支付流程，屏蔽后端报错 ---
		uni.showLoading({ title: '正在提交订单...' })
		
		// 模拟网络延迟
		setTimeout(() => {
			uni.hideLoading()
			
			uni.showModal({
				title: '模拟支付确认',
				content: `由于当前环境未配置支付商户，系统将进行模拟支付。\n待支付金额：￥${cartStore.totalAmount}`,
				confirmText: '确认支付',
				cancelText: '取消',
				success: (modalRes) => {
					if (modalRes.confirm) {
						// 模拟支付成功逻辑
						onMockPaySuccess()
					} else {
						uni.showToast({ title: '已取消支付', icon: 'none' })
					}
				}
			})
		}, 800)
	}

	async function onMockPaySuccess() {
		uni.showLoading({ title: '支付处理中...' })

		try {
			// 即使是模拟，我们也尝试告知后端创建订单（如果后端逻辑允许）
			// 如果后端依然报错，我们就在 catch 里继续模拟成功的 UI 流程
			const createRes = await request<any>({
				url: '/order/create_new',
				method: 'POST',
				data: {
					items: cartStore.items.filter(i => i.selected),
					order_type: appStore.orderMode === 'self-pickup' ? 1 : 2,
					address_id: appStore.orderMode === 'delivery' ? addressStore.selectedAddress?.id : 0,
					remark: remark.value
				}
			})
			currentOrderId.value = createRes.result.id

			// 通知后端支付成功
			await request<any>({
				url: '/order/pay_success',
				method: 'POST',
				data: {
					id: currentOrderId.value,
					out_trade_no: `MOCK_OUT_${Date.now()}`,
					transaction_id: `MOCK_TRANS_${Date.now()}`
				}
			})

			uni.hideLoading()
			uni.showToast({ title: '支付成功', icon: 'success' })

			// 清空购物车中已选中的商品
			const remainingItems = cartStore.items.filter(i => !i.selected)
			cartStore.items = remainingItems
			cartStore.saveToStorage()

			// 跳转到订单列表
			setTimeout(() => {
				uni.switchTab({
					url: '/pages/order/order'
				})
			}, 1500)
		} catch (e: any) {
			uni.hideLoading()
			console.error('订单创建失败:', e)

			// 判断是否是库存不足错误
			const errorMsg = e.message || '订单创建失败'
			if (errorMsg.includes('库存不足')) {
				uni.showModal({
					title: '库存不足',
					content: '商品库存不足，请返回购物车修改数量',
					confirmText: '返回购物车',
					success: (res) => {
						if (res.confirm) {
							uni.navigateBack()
						}
					}
				})
			} else {
				uni.showToast({ title: errorMsg, icon: 'none' })
			}
		}
	}

	// uni-pay-x 回调：支付订单创建成功
	function onPayCreate(res: UTSJSONObject) {
		console.log('支付订单创建成功:', res)
	}

	// uni-pay-x 回调：支付成功
	async function onPaySuccess(res: UTSJSONObject) {
		console.log('支付成功:', res)

		try {
			uni.showLoading({ title: '处理中...' })

			// 通知后端支付成功，更新订单状态
			await request<any>({
				url: '/order/pay_success',
				method: 'POST',
				data: {
					id: currentOrderId.value,
					out_trade_no: res['out_trade_no'],
					transaction_id: res['transaction_id']
				}
			})

			uni.hideLoading()
			uni.showToast({ title: '支付成功', icon: 'success' })

			// 清空购物车
			cartStore.clearCart()

			// 跳转到订单列表
			setTimeout(() => {
				uni.switchTab({
					url: '/pages/order/order'
				})
			}, 1500)

		} catch (err) {
			uni.hideLoading()
			console.error('更新订单状态失败:', err)
			// 即使更新失败，支付已成功，仍然跳转
			uni.showToast({ title: '支付成功', icon: 'success' })
			cartStore.clearCart()
			setTimeout(() => {
				uni.switchTab({
					url: '/pages/order/order'
				})
			}, 1500)
		}
	}

	// uni-pay-x 回调：支付失败
	function onPayFail(res: UTSJSONObject) {
		console.log('支付失败:', res)
		uni.showToast({
			title: res['errMsg'] as string || '支付失败',
			icon: 'none'
		})
	}

	// uni-pay-x 回调：用户取消支付
	function onPayCancel(res: any) {
		console.log('用户取消支付:', res)
		uni.showToast({ title: '已取消支付', icon: 'none' })

		// 可选：取消支付后也跳转到订单列表，订单状态为待支付
		setTimeout(() => {
			uni.switchTab({
				url: '/pages/order/order'
			})
		}, 1500)
	}
</script>

<style>
	.page-wrapper {
		display: flex;
		flex-direction: column;
		height: 100vh;
		background-color: #f5f5f5;
	}

	.container {
		flex: 1;
	}

	.address-section {
		display: flex;
		flex-direction: row;
		align-items: center;
		justify-content: space-between;
		min-height: 160rpx;
		padding: 30rpx;
		border-left: 8rpx solid #00cc99;
	}

	.address-info {
		flex: 1;
		margin-right: 20rpx;
	}

	.address-main {
		margin-bottom: 12rpx;
	}

	.address-text {
		font-size: 32rpx;
		font-weight: bold;
		color: #333;
		line-height: 1.4;
	}

	.address-user {
		display: flex;
		flex-direction: row;
		align-items: center;
	}

	.user-name {
		font-size: 26rpx;
		color: #666;
		margin-right: 20rpx;
	}

	.user-phone {
		font-size: 26rpx;
		color: #666;
	}

	.address-placeholder {
		flex: 1;
	}

	.placeholder-text {
		font-size: 32rpx;
		color: #ccc;
		font-weight: 500;
	}

	.css-arrow-right-large {
		width: 14rpx;
		height: 14rpx;
		border-top: 3rpx solid #ccc;
		border-right: 3rpx solid #ccc;
		transform: rotate(45deg);
	}

	.card {
		background-color: #fff;
		margin: 20rpx;
		padding: 30rpx;
		border-radius: 16rpx;
	}

	.section-title {
		font-size: 28rpx;
		font-weight: bold;
		margin-bottom: 20rpx;
		border-bottom: 1rpx solid #eee;
		padding-bottom: 10rpx;
	}

	.mode-row {
		margin-bottom: 20rpx;
	}

	.mode-label {
		font-size: 32rpx;
		font-weight: bold;
		color: #00cc99;
	}

	.store-name {
		font-size: 30rpx;
		font-weight: bold;
		display: block;
	}

	.store-address {
		font-size: 24rpx;
		color: #999;
		margin-top: 10rpx;
		display: block;
	}

	.order-item {
		display: flex;
		flex-direction: row;
		justify-content: space-between;
		padding: 20rpx 0;
		border-bottom: 1rpx solid #fafafa;
	}

	.item-info {
		display: flex;
		flex-direction: column;
	}

	.item-name {
		font-size: 28rpx;
	}

	.item-specs {
		font-size: 22rpx;
		color: #999;
		margin-top: 4rpx;
	}

	.item-right {
		display: flex;
		flex-direction: row;
		align-items: center;
	}

	.item-quantity {
		font-size: 26rpx;
		color: #666;
		margin-right: 30rpx;
	}

	.item-price {
		font-size: 28rpx;
		font-weight: bold;
	}

	.total-row {
		display: flex;
		flex-direction: row;
		justify-content: space-between;
		margin-top: 30rpx;
		padding-top: 20rpx;
		border-top: 1rpx solid #eee;
	}

	.total-label {
		font-size: 30rpx;
		font-weight: bold;
	}

	.total-price {
		font-size: 36rpx;
		font-weight: bold;
		color: #ff4d4f;
	}

	.remark-row {
		display: flex;
		flex-direction: row;
		align-items: center;
	}

	.remark-label {
		font-size: 28rpx;
		width: 100rpx;
	}

	.remark-input {
		flex: 1;
		font-size: 28rpx;
	}

	.footer-bar {
		background-color: #fff;
		display: flex;
		flex-direction: row;
		justify-content: space-between;
		align-items: center;
		padding: 20rpx 30rpx;
		padding-bottom: calc(20rpx + constant(safe-area-inset-bottom));
		padding-bottom: calc(20rpx + env(safe-area-inset-bottom));
		box-shadow: 0 -2rpx 20rpx rgba(0,0,0,0.05);
	}

	.footer-left {
		display: flex;
		flex-direction: row;
		align-items: baseline;
	}

	.footer-total-label {
		font-size: 24rpx;
		color: #666;
		margin-right: 10rpx;
	}

	.footer-total-price {
		font-size: 44rpx;
		font-weight: bold;
		color: #ff4d4f;
	}

	.pay-btn {
		background-color: #00cc99;
		padding: 0 60rpx;
		height: 88rpx;
		border-radius: 44rpx;
		display: flex;
		align-items: center;
		justify-content: center;
	}

	.pay-btn-text {
		color: #fff;
		font-size: 32rpx;
		font-weight: bold;
	}
</style>