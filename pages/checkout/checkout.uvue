<template>
	<view class="page-wrapper">
		<scroll-view class="container" scroll-y>
			<!-- 外卖配送地址选择 -->
			<view v-if="appStore.orderMode === 'delivery'" class="section card address-section" @click="goToSelectAddress">
				<view v-if="addressStore.selectedAddress" class="address-info">
					<view class="address-main">
						<text class="address-text">{{addressStore.selectedAddress.province}}{{addressStore.selectedAddress.city}}{{addressStore.selectedAddress.district}} {{addressStore.selectedAddress.detail}}</text>
					</view>
					<view class="address-user">
						<text class="user-name">{{addressStore.selectedAddress.name}}</text>
						<text class="user-phone">{{addressStore.selectedAddress.phone}}</text>
					</view>
				</view>
				<view v-else class="address-placeholder">
					<text class="placeholder-text">请选择收货地址</text>
				</view>
				<view class="css-arrow-right-large"></view>
			</view>

			<!-- 门店信息 (自取模式显示) -->
			<view v-if="appStore.orderMode === 'self-pickup'" class="section card">
				<view class="mode-row">
					<text class="mode-label">门店自取</text>
				</view>
				<view class="store-row">
					<text class="store-name">{{appStore.currentStore?.name}}</text>
					<text class="store-address">{{appStore.currentStore?.address}}</text>
				</view>
			</view>

			<!-- 订单明细 -->
			<view class="section card">
				<view class="section-title">
					<text>订单明细</text>
				</view>
				<view v-for="(item, index) in selectedItems" :key="index" class="order-item">
					<view class="item-info">
						<text class="item-name">{{item.name}}</text>
						<text class="item-specs">{{item.specs.join('/')}}</text>
					</view>
					<view class="item-right">
						<text class="item-quantity">x{{item.quantity}}</text>
						<text class="item-price">￥{{item.totalPrice}}</text>
					</view>
				</view>
				<view class="total-row">
					<text class="total-label">合计</text>
					<text class="total-price">￥{{cartStore.totalAmount}}</text>
				</view>
			</view>

			<!-- 优惠券选择 -->
			<view class="section card coupon-section" @click="openCouponPopup">
				<view class="coupon-row">
					<view class="coupon-left">
						<text class="coupon-icon">🏷️</text>
						<text class="coupon-label">优惠券</text>
					</view>
					<view class="coupon-right" v-if="couponList.length > 0">
						<text class="coupon-selected-text" v-if="selectedCouponId > 0">
							已减 ￥{{discountAmount}}
						</text>
						<text class="coupon-count-text" v-else>
							{{availableCount}}张可用
						</text>
						<view class="css-arrow-right-large"></view>
					</view>
					<text class="coupon-empty-text" v-else>暂无可用优惠券</text>
				</view>
			</view>

			<!-- 支付方式选择 -->
			<view class="section card payment-section">
				<view class="section-title">
					<text>支付方式</text>
				</view>
				<view class="pay-methods-list">
					<view class="pay-method-item" :class="{'pay-method-active': selectedPayType === 1}" @click="selectedPayType = 1">
						<view class="pay-method-left">
							<view class="pay-icon-circle pay-wechat-circle"></view>
							<text class="pay-method-name">微信支付</text>
						</view>
						<view class="pay-check" :class="{'pay-check-active': selectedPayType === 1}">
							<text v-if="selectedPayType === 1" class="check-icon">✓</text>
						</view>
					</view>
					<view class="pay-method-item" :class="{'pay-method-active': selectedPayType === 2}" @click="selectedPayType = 2">
						<view class="pay-method-left">
							<view class="pay-icon-circle pay-alipay-circle"></view>
							<text class="pay-method-name">支付宝</text>
						</view>
						<view class="pay-check" :class="{'pay-check-active': selectedPayType === 2}">
							<text v-if="selectedPayType === 2" class="check-icon">✓</text>
						</view>
					</view>
					<view class="pay-method-item" :class="{'pay-method-active': selectedPayType === 3}" @click="selectedPayType = 3">
						<view class="pay-method-left">
							<view class="pay-icon-circle pay-unionpay-circle"></view>
							<text class="pay-method-name">云闪付</text>
						</view>
						<view class="pay-check" :class="{'pay-check-active': selectedPayType === 3}">
							<text v-if="selectedPayType === 3" class="check-icon">✓</text>
						</view>
					</view>
				</view>
			</view>

			<!-- 备注 -->
			<view class="section card">
				<view class="remark-row">
					<text class="remark-label">备注</text>
					<input class="remark-input" placeholder="请填写您的备注要求" v-model="remark" />
				</view>
			</view>

			<!-- 底部占位 -->
			<view style="height: 180rpx;"></view>
		</scroll-view>

		<!-- 底部结算栏 -->
		<view class="footer-bar">
			<view class="footer-left">
				<view class="footer-price-row">
					<text class="footer-total-label">合计</text>
					<text class="footer-original-price" v-if="discountAmount > 0">￥{{cartStore.totalAmount}}</text>
					<text class="footer-discount" v-if="discountAmount > 0">-￥{{discountAmount}}</text>
				</view>
				<view class="footer-pay-row">
					<text class="footer-pay-label">待支付</text>
					<text class="footer-total-price">￥{{payAmount}}</text>
				</view>
			</view>
			<view class="pay-btn" @click="handlePay">
				<text class="pay-btn-text">立即支付</text>
			</view>
		</view>

		<!-- 优惠券选择弹窗 -->
		<uni-popup ref="couponPopup" type="bottom" background-color="#ffffff" :mask-click="true">
			<view class="coupon-popup">
				<view class="popup-header">
					<text class="popup-title">选择优惠券</text>
					<text class="popup-close" @click="closeCouponPopup">✕</text>
				</view>
				<scroll-view scroll-y class="coupon-scroll">
					<!-- 不使用优惠券 -->
					<view class="coupon-item" :class="{'coupon-item-active': selectedCouponId === 0}" @click="selectCoupon(0)">
						<view class="coupon-item-left no-coupon-left">
							<text class="no-coupon-text">不使用优惠券</text>
						</view>
						<view class="coupon-check" :class="{'check-active': selectedCouponId === 0}">
							<text v-if="selectedCouponId === 0" class="check-icon">✓</text>
						</view>
					</view>
					<!-- 优惠券列表 -->
					<view
						v-for="(item, idx) in couponList"
						:key="idx"
						class="coupon-item"
						:class="{
							'coupon-item-active': selectedCouponId === item.id,
							'coupon-item-disabled': !item._available
						}"
						@click="item._available ? selectCoupon(item.id) : null"
					>
						<view class="coupon-item-left" :class="{'coupon-left-disabled': !item._available}">
							<text class="coupon-item-value" :class="{'value-small': item.template?.type === 2}">
								{{formatCouponValue(item)}}
							</text>
							<text class="coupon-item-condition" v-if="item.template?.min_spend > 0">
								满{{item.template.min_spend}}可用
							</text>
							<text class="coupon-item-condition" v-else>无门槛</text>
						</view>
						<view class="coupon-item-divider">
							<view class="divider-dot top"></view>
							<view class="divider-line"></view>
							<view class="divider-dot bottom"></view>
						</view>
						<view class="coupon-item-right">
							<text class="coupon-item-name">{{item.template?.name || '优惠券'}}</text>
							<text class="coupon-item-desc">{{formatCouponType(item)}}</text>
							<text class="coupon-item-reason" v-if="!item._available">{{item._reason}}</text>
						</view>
						<view class="coupon-check" :class="{'check-active': selectedCouponId === item.id}">
							<text v-if="selectedCouponId === item.id" class="check-icon">✓</text>
						</view>
					</view>
				</scroll-view>
			</view>
		</uni-popup>

		<!-- uni-pay-x 支付组件 -->
		<uni-pay
			ref="uniPayRef"
			return-url="/pages/order/detail"
			@success="onPaySuccess"
			@fail="onPayFail"
			@cancel="onPayCancel"
			@create="onPayCreate"
		/>
	</view>
</template>

<script setup lang="uts">
	import { ref, onMounted, getCurrentInstance, computed } from 'vue'
	import { useAppStore } from '@/store/app.uts'
	import { useCartStore } from '@/store/cart.uts'
	import { useUserStore } from '@/store/user.uts'
	import { useAddressStore } from '@/store/address.uts'
	import { request } from '@/utils/request.uts'

	const appStore = useAppStore()
	const cartStore = useCartStore()
	const userStore = useUserStore()
	const addressStore = useAddressStore()
	const remark = ref('')
	const selectedPayType = ref(1) // 1: 微信支付, 2: 支付宝, 3: 云闪付
	const uniPayRef = ref(null)
	const currentOrderId = ref(0)

	// 优惠券相关状态
	const couponList = ref([] as any[])
	const selectedCouponId = ref(0)
	const discountAmount = ref(0)
	const couponPopup = ref(null)

	// 支付金额 = 总金额 - 优惠
	const payAmount = computed(() => {
		const amount = cartStore.totalAmount - discountAmount.value
		return amount > 0 ? amount.toFixed(2) : '0.00'
	})

	// 可用优惠券数量
	const availableCount = computed(() => {
		return couponList.value.filter((c: any) => (c as UTSJSONObject)['_available']).length
	})

	const selectedItems = computed(() : CartItem[] => {
		return cartStore.items.filter(i => i.selected)
	})

	// 获取当前实例用于访问 $refs
	const instance = getCurrentInstance()

	onMounted(() => {
		if (appStore.orderMode === 'delivery') {
			addressStore.fetchAddresses()
		}
		fetchCoupons()
	})

	// ========== 优惠券逻辑 ==========

	// 获取用户未使用优惠券
	async function fetchCoupons() {
		try {
			const res = await request<any>({
				url: '/coupon/mine',
				method: 'GET',
				data: { status: 0, pageNum: 1, pageSize: 100 }
			})
			const result = res.result as UTSJSONObject
			const list = (result['list'] || []) as any[]

			// 客户端预筛选 + 标记可用性
			const totalAmount = cartStore.totalAmount
			const storeId = appStore.currentStore?.id || 0
			const now = new Date()

			for (let i = 0; i < list.length; i++) {
				const item = list[i] as UTSJSONObject
				const template = item['template'] as UTSJSONObject
				const obj = item as any

				if (!template) {
					obj['_available'] = false
					obj['_reason'] = '优惠券信息异常'
					continue
				}

				const endTime = new Date(template['end_time'] as string)
				const templateStoreId = template['store_id'] as number | null
				const minSpend = parseFloat(template['min_spend'] as string || '0')

				if (endTime < now) {
					obj['_available'] = false
					obj['_reason'] = '已过期'
				} else if (templateStoreId != null && templateStoreId !== 0 && templateStoreId !== storeId) {
					obj['_available'] = false
					obj['_reason'] = '不适用当前门店'
				} else if (minSpend > 0 && totalAmount < minSpend) {
					obj['_available'] = false
					obj['_reason'] = `需满${minSpend}元可用`
				} else {
					obj['_available'] = true
					obj['_reason'] = ''
				}
			}

			couponList.value = list

			// 自动选中优惠最大的可用券
			autoSelectBestCoupon()
		} catch (e) {
			console.error('获取优惠券失败', e)
		}
	}

	// 自动选中优惠金额最大的优惠券
	function autoSelectBestCoupon() {
		let bestId = 0
		let bestDiscount = 0
		const totalAmount = cartStore.totalAmount

		for (let i = 0; i < couponList.value.length; i++) {
			const item = couponList.value[i] as UTSJSONObject
			if (!(item['_available'] as boolean)) continue

			const discount = calcCouponDiscount(item, totalAmount)
			if (discount > bestDiscount) {
				bestDiscount = discount
				bestId = item['id'] as number
			}
		}

		if (bestId > 0) {
			selectedCouponId.value = bestId
			discountAmount.value = bestDiscount
		}
	}

	// 客户端计算优惠券折扣金额
	function calcCouponDiscount(item: UTSJSONObject, totalAmount: number): number {
		const template = item['template'] as UTSJSONObject
		if (!template) return 0

		const type = template['type'] as number
		const value = parseFloat(template['value'] as string)
		let discount = 0

		if (type === 1) {
			// 满减券
			discount = value
		} else if (type === 2) {
			// 折扣券
			discount = totalAmount * (1 - value)
			const maxDiscount = template['max_discount'] as string | null
			if (maxDiscount && parseFloat(maxDiscount) > 0) {
				discount = Math.min(discount, parseFloat(maxDiscount))
			}
		} else if (type === 3) {
			// 固定金额券
			discount = value
		}

		// 优惠不超过总价
		discount = Math.min(discount, totalAmount)
		return Math.round(discount * 100) / 100
	}

	// 选择优惠券
	function selectCoupon(couponId: number) {
		selectedCouponId.value = couponId
		if (couponId === 0) {
			discountAmount.value = 0
		} else {
			for (let i = 0; i < couponList.value.length; i++) {
				const item = couponList.value[i] as UTSJSONObject
				if ((item['id'] as number) === couponId) {
					discountAmount.value = calcCouponDiscount(item, cartStore.totalAmount)
					break
				}
			}
		}
		closeCouponPopup()
	}

	// 打开优惠券选择弹窗
	function openCouponPopup() {
		if (couponList.value.length === 0) return
		if (couponPopup.value) {
			(couponPopup.value as any).open()
		}
	}

	// 关闭优惠券选择弹窗
	function closeCouponPopup() {
		if (couponPopup.value) {
			(couponPopup.value as any).close()
		}
	}

	// 格式化优惠券金额
	function formatCouponValue(item: any): string {
		const template = (item as UTSJSONObject)['template'] as UTSJSONObject
		if (!template) return '-'
		const type = template['type'] as number
		const value = template['value'] as string
		if (type === 2) return `${(parseFloat(value) * 10).toFixed(0)}折`
		return `¥${parseFloat(value).toFixed(0)}`
	}

	// 格式化优惠券类型
	function formatCouponType(item: any): string {
		const template = (item as UTSJSONObject)['template'] as UTSJSONObject
		if (!template) return ''
		const type = template['type'] as number
		if (type === 1) return '满减券'
		if (type === 2) return '折扣券'
		if (type === 3) return '固定金额券'
		return ''
	}

	function goToSelectAddress() {
		uni.navigateTo({
			url: '/pages/profile/address'
		})
	}

	/**
	 * 库存预检查 - 在创建订单前检查商品库存是否充足
	 */
	async function checkStock(): Promise<boolean> {
		const selectedItems = cartStore.items.filter(i => i.selected)
		if (selectedItems.length === 0) return false

		try {
			const res = await request<any>({
				url: '/order/check_stock',
				method: 'POST',
				data: {
					store_id: appStore.currentStore?.id,
					items: selectedItems.map(item => ({
						goods_id: item.id,
						quantity: item.quantity,
						name: item.name
					}))
				}
			})

			if (res.result != null && !res.result.all_available) {
				// 找出库存不足的商品
				const unavailableItems = (res.result.items as any[]).filter((i: any) => !i.available)
				const itemNames = unavailableItems.map((i: any) => `${i.name}(库存:${i.stock})`).join('、')

				uni.showModal({
					title: '库存不足',
					content: `以下商品库存不足：${itemNames}，请修改数量后再试`,
					showCancel: false,
					confirmText: '知道了'
				})
				return false
			}

			return true
		} catch (e) {
			console.error('库存检查失败:', e)
			// 检查接口失败时不阻塞，让创建订单接口来判断
			return true
		}
	}

	async function handlePay() {
		if (userStore.token == '') {
			uni.showToast({ title: '请先登录', icon: 'none' })
			return
		}
		
		const selectedItems = cartStore.items.filter(i => i.selected)
		if (selectedItems.length === 0) {
			uni.showToast({ title: '请选择要结算的商品', icon: 'none' })
			return
		}

		// 外卖配送模式下，必须选择地址
		if (appStore.orderMode === 'delivery' && !addressStore.selectedAddress) {
			uni.showToast({ title: '请选择收货地址', icon: 'none' })
			return
		}

		// 库存预检查
		const stockOk = await checkStock()
		if (!stockOk) return

		// --- 完全模拟支付流程，屏蔽后端报错 ---
		uni.showLoading({ title: '正在提交订单...' })
		
		// 模拟网络延迟
		setTimeout(() => {
			uni.hideLoading()
			
			uni.showModal({
				title: '模拟支付确认',
				content: `由于当前环境未配置支付商户，系统将进行模拟支付。\n待支付金额：￥${payAmount.value}`,
				confirmText: '确认支付',
				cancelText: '取消',
				success: (modalRes) => {
					if (modalRes.confirm) {
						// 模拟支付成功逻辑
						onMockPaySuccess()
					} else {
						uni.showToast({ title: '已取消支付', icon: 'none' })
					}
				}
			})
		}, 800)
	}

	async function onMockPaySuccess() {
		uni.showLoading({ title: '支付处理中...' })

		try {
			// 即使是模拟，我们也尝试告知后端创建订单（如果后端逻辑允许）
			// 如果后端依然报错，我们就在 catch 里继续模拟成功的 UI 流程
			const createRes = await request<any>({
				url: '/order/create_new',
				method: 'POST',
				data: {
					store_id: appStore.currentStore?.id,
					items: cartStore.items.filter(i => i.selected),
					order_type: appStore.orderMode === 'self-pickup' ? 1 : 2,
					address_id: appStore.orderMode === 'delivery' ? addressStore.selectedAddress?.id : 0,
					remark: remark.value,
					coupon_id: selectedCouponId.value > 0 ? selectedCouponId.value : undefined,
					pay_type: selectedPayType.value
				}
			})
			currentOrderId.value = createRes.result.id

			// 通知后端支付成功
			await request<any>({
				url: '/order/pay_success',
				method: 'POST',
				data: {
					id: currentOrderId.value,
					out_trade_no: `MOCK_OUT_${Date.now()}`,
					transaction_id: `MOCK_TRANS_${Date.now()}`,
					pay_type: selectedPayType.value
				}
			})

			uni.hideLoading()
			uni.showToast({ title: '支付成功', icon: 'success' })

			// 清空购物车中已选中的商品
			const remainingItems = cartStore.items.filter(i => !i.selected)
			cartStore.items = remainingItems
			cartStore.saveToStorage()

			// 跳转到订单列表
			setTimeout(() => {
				uni.switchTab({
					url: '/pages/order/order'
				})
			}, 1500)
		} catch (e: any) {
			uni.hideLoading()
			console.error('订单创建失败:', e)

			const errorMsg = e.message || '订单创建失败'
			if (errorMsg.includes('库存不足') || errorMsg.includes('不在当前门店')) {
				uni.showModal({
					title: '结算失败',
					content: errorMsg,
					confirmText: '返回购物车',
					success: (res) => {
						if (res.confirm) {
							uni.navigateBack()
						}
					}
				})
			} else {
				uni.showToast({ title: errorMsg, icon: 'none' })
			}
		}
	}

	// uni-pay-x 回调：支付订单创建成功
	function onPayCreate(res: UTSJSONObject) {
		console.log('支付订单创建成功:', res)
	}

	// uni-pay-x 回调：支付成功
	async function onPaySuccess(res: UTSJSONObject) {
		console.log('支付成功:', res)

		try {
			uni.showLoading({ title: '处理中...' })

			// 通知后端支付成功，更新订单状态
			await request<any>({
				url: '/order/pay_success',
				method: 'POST',
				data: {
					id: currentOrderId.value,
					out_trade_no: res['out_trade_no'],
					transaction_id: res['transaction_id'],
					pay_type: selectedPayType.value
				}
			})

			uni.hideLoading()
			uni.showToast({ title: '支付成功', icon: 'success' })

			// 清空购物车
			cartStore.clearCart()

			// 跳转到订单列表
			setTimeout(() => {
				uni.switchTab({
					url: '/pages/order/order'
				})
			}, 1500)

		} catch (err) {
			uni.hideLoading()
			console.error('更新订单状态失败:', err)
			// 即使更新失败，支付已成功，仍然跳转
			uni.showToast({ title: '支付成功', icon: 'success' })
			cartStore.clearCart()
			setTimeout(() => {
				uni.switchTab({
					url: '/pages/order/order'
				})
			}, 1500)
		}
	}

	// uni-pay-x 回调：支付失败
	function onPayFail(res: UTSJSONObject) {
		console.log('支付失败:', res)
		uni.showToast({
			title: res['errMsg'] as string || '支付失败',
			icon: 'none'
		})
	}

	// uni-pay-x 回调：用户取消支付
	function onPayCancel(res: any) {
		console.log('用户取消支付:', res)
		uni.showToast({ title: '已取消支付', icon: 'none' })

		// 可选：取消支付后也跳转到订单列表，订单状态为待支付
		setTimeout(() => {
			uni.switchTab({
				url: '/pages/order/order'
			})
		}, 1500)
	}
</script>

