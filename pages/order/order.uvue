<template>
	<view class="page-container">
		<!-- 顶部 Tab 切换 -->
		<view class="tab-header">
			<view 
				v-for="(tab, index) in tabs" 
				:key="index" 
				:class="['tab-item', activeTab === index ? 'active' : '']"
				@click="switchTab(index)"
			>
				<text :class="['tab-text', activeTab === index ? 'active-text' : '']">{{tab}}</text>
				<view class="tab-line" v-if="activeTab === index"></view>
			</view>
		</view>
		
		<scroll-view class="order-scroll" scroll-y @refresherrefresh="onRefresh" :refresher-enabled="true" :refresher-triggered="isRefreshing">
			<!-- 订单列表 -->
			<view v-for="order in orders" :key="order.id" class="order-card" @click="goToDetail(order)">
				<view class="card-header">
					<view class="store-info">
						<text class="store-name">{{order.order_type === 1 ? '门店自取' : '外卖配送'}}</text>
						<text class="order-time">{{formatDate(order.createdAt)}}</text>
					</view>
					<text :class="['order-status', order.state === 1 ? 'status-ongoing' : 'status-done']">
						{{formatStatus(order.state)}}
					</text>
				</view>
				
				<view class="card-body">
					<view class="item-list">
						<view v-for="(item, index) in order.order_items" :key="index" class="item-row">
							<view class="item-left">
								<text class="item-name">{{item.product?.goods_name}}</text>
								<text class="item-specs" v-if="item.specs">{{item.specs}}</text>
							</view>
							<text class="item-count">x{{item.quantity}}</text>
						</view>
					</view>
					<view class="price-row">
						<text class="total-label">实付</text>
						<text class="total-symbol">￥</text>
						<text class="total-amount">{{order.total_price}}</text>
					</view>
				</view>
				
				<view class="card-footer">
					<!-- 左侧：取餐码展示或占位 -->
					<view class="pickup-section">
						<template v-if="order.state === 1 && order.pickup_code">
							<text class="pickup-label">取餐码</text>
							<text class="pickup-code">{{order.pickup_code}}</text>
						</template>
					</view>
					
					<!-- 右侧：操作按钮 -->
					<view class="action-btns">
						<!-- 待支付状态显示去支付 -->
						<view class="btn btn-primary" v-if="order.state === 0" @click.stop="payPendingOrder(order)">
							<text class="btn-text white-text">去支付</text>
						</view>
						<!-- 其他状态显示再来一单 -->
						<view class="btn btn-primary" v-else @click.stop="reOrder(order)">
							<text class="btn-text white-text">再来一单</text>
						</view>
					</view>
				</view>
			</view>
			
			<!-- 空状态 -->
			<view v-if="orders.length === 0 && !isLoading" class="empty-state">
				<view class="empty-image-box">
					<text class="empty-icon">☕</text>
				</view>
				<text class="empty-title">还没有订单记录</text>
				<view class="go-order-btn" @click="goToMenu">
					<text class="go-order-text">去喝一杯</text>
				</view>
			</view>
			
			<view v-if="isLoading" class="loading-state">
				<text class="loading-text">加载中...</text>
			</view>
			
			<view style="height: 40rpx;"></view>
		</scroll-view>
	</view>
</template>

<script setup lang="uts">
	import { ref, onMounted } from 'vue'
	import { onShow } from '@dcloudio/uni-app'
	import { request } from '@/utils/request.uts'
	import { useUserStore } from '@/store/user.uts'
	import { useCartStore, CartItem } from '@/store/cart.uts'
	import { useAppStore } from '@/store/app.uts'

	const userStore = useUserStore()
	const appStore = useAppStore()
	const tabs = ['全部', '已完成', '待支付', '已取消']
	const activeTab = ref(0)
	const orders = ref<any[]>([])
	const isLoading = ref(false)
	const isRefreshing = ref(false)

	onMounted(() => {
		fetchOrders()
	})

	onShow(() => {
		// 检查是否有从“我的”页面传过来的初始 Tab 索引
		if (appStore.orderTabIndex !== activeTab.value) {
			activeTab.value = appStore.orderTabIndex
		}
		// 每次进入页面都刷新一次列表，确保能看到最新订单状态
		fetchOrders()
	})

	async function fetchOrders() {
		if (userStore.token === '') return
		
		isLoading.value = true
		try {
			const res = await request<any>({
				url: '/order/my_list',
				method: 'GET'
			})
			
			const allOrders = res.result.list as any[]
			
			// 前端简单过滤
			if (activeTab.value === 0) {
				orders.value = allOrders
			} else if (activeTab.value === 1) {
				// 已完成 (包括已评价)
				orders.value = allOrders.filter(o => o.state === 2 || o.state === 3)
			} else if (activeTab.value === 2) {
				// 待支付
				orders.value = allOrders.filter(o => o.state === 0)
			} else if (activeTab.value === 3) {
				// 已取消 (假设状态为 -1 或其他)
				orders.value = allOrders.filter(o => o.state < 0 || o.state > 3)
			}
			
		} catch (e) {
			console.error(e)
		} finally {
			isLoading.value = false
			isRefreshing.value = false
		}
	}

	function switchTab(index: number) {
		activeTab.value = index
		fetchOrders()
	}

	function onRefresh() {
		isRefreshing.value = true
		fetchOrders()
	}

	function formatStatus(state: number): string {
		switch(state) {
			case 0: return '待支付'
			case 1: return '制作中'
			case 2: return '已完成'
			case 3: return '已评价'
			default: return '已取消'
		}
	}

	function formatDate(dateStr: string): string {
		if (!dateStr) return ''
		const d = new Date(dateStr)
		return `${d.getFullYear()}-${(d.getMonth()+1).toString().padStart(2, '0')}-${d.getDate().toString().padStart(2, '0')} ${d.getHours().toString().padStart(2, '0')}:${d.getMinutes().toString().padStart(2, '0')}`
	}

	function goToMenu() {
		uni.switchTab({
			url: '/pages/menu/menu'
		})
	}

	function reOrder(order: any) {
		const cartStore = useCartStore()
		const items = order.order_items as any[]
		cartStore.addReorderItems(items, appStore.currentStore?.id || 0)
	}
	
	async function payPendingOrder(order: any) {
		uni.showLoading({ title: '处理中...' })
		try {
			await request<any>({
				url: '/order/pay',
				method: 'POST',
				data: { id: order.id }
			})
			uni.hideLoading()
			uni.showToast({ title: '支付成功', icon: 'success' })
			fetchOrders()
		} catch (payErr) {
			uni.hideLoading()
		}
	}

	function goToDetail(order: any) {
		uni.navigateTo({
			url: `/pages/order/detail?id=${order.id}`
		})
	}
</script>

<style>
