		align-items: center;
	}

	.product-qty {
		font-size: 26rpx;
		color: #999;
		margin-right: 30rpx;
	}

	.product-price {
		font-size: 28rpx;
		font-weight: bold;
		color: #333;
		width: 100rpx;
		text-align: right;
	}

	.price-breakdown {
		margin-top: 30rpx;
		padding-top: 30rpx;
		border-top: 1rpx solid #f5f5f5;
	}

	.price-row {
		display: flex;
