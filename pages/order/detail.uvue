		background: linear-gradient(135deg, #FFB84D 0%, #FF9500 100%);
	}

	.status-bg-making {
		background: linear-gradient(135deg, #00E0A3 0%, #00CC99 100%);
	}

	.status-bg-completed, .status-bg-rated {
		background: linear-gradient(135deg, #4D4D4D 0%, #333333 100%);
	}

	.status-bg-expired, .status-bg-cancelled {
		background: linear-gradient(135deg, #CCCCCC 0%, #999999 100%);
	}

