<template>
	<view class="page-container">
		<!-- 状态头部 -->
		<view class="status-header" :class="'status-bg-' + getStatusClassSuffix(order?.state ?? 0)">
			<view class="status-content">
				<view class="status-text-area">
					<text class="status-title">{{formatStatus(order?.state ?? 0)}}</text>
					<text class="status-desc" v-if="order?.state === 0 && countdownText">支付剩余时间 {{countdownText}}</text>
					<text class="status-desc" v-else>{{getStatusDesc(order?.state ?? 0)}}</text>
				</view>
				<view class="status-icon-box">
					<uni-icons :type="getStatusIconType(order?.state ?? 0)" size="48" color="#ffffff"></uni-icons>
				</view>
			</view>
			<!-- 背景装饰 -->
			<view class="status-decoration">
				<uni-icons :type="getStatusIconType(order?.state ?? 0)" size="120" color="rgba(255, 255, 255, 0.1)"></uni-icons>
			</view>
		</view>

		<scroll-view class="detail-content" scroll-y>
			<!-- 配送/自取信息 -->
			<view class="card info-card">
				<view class="info-row" v-if="order?.order_type === 1">
					<view class="info-label-box">
						<text class="info-label">自取门店</text>
					</view>
					<view class="info-value-box">
						<text class="store-name">勇哥茶饮 (默认门店)</text>
						<text class="store-address">某某路 123 号</text>
					</view>
				</view>
				<view class="info-row" v-else>
					<view class="info-label-box">
						<text class="info-label">配送地址</text>
					</view>
					<view class="info-value-box">
						<text class="address-text">{{formatAddress(order)}}</text>	
						<text class="user-info">{{formatUserInfo(order)}}</text>	
					</view>
				</view>

				<!-- 取餐码 (仅自取且制作中/已完成) -->
				<view class="pickup-section" v-if="order?.order_type === 1 && order?.state !== 0 && order?.pickup_code">
					<view class="pickup-divider"></view>
					<view class="pickup-content">
						<text class="pickup-label">取餐码</text>
						<text class="pickup-code">{{order?.pickup_code}}</text>
					</view>
				</view>
			</view>

			<!-- 商品列表 -->
			<view class="card items-card">
				<view class="card-title">
					<text class="title-text">商品明细</text>
				</view>
				<view v-for="(item, index) in order?.order_items" :key="index" class="product-item">
					<view class="product-info">
						<text class="product-name">{{item.product?.goods_name}}</text>	
						<text class="product-specs" v-if="item.specs">{{item.specs}}</text>
					</view>
					<view class="product-right">
						<text class="product-qty">x{{item.quantity}}</text>
						<text class="product-price">￥{{item.price}}</text>
					</view>
				</view>

				<view class="price-breakdown">
					<view class="price-row">
						<text class="price-label">商品小计</text>
						<text class="price-value">￥{{order?.total_price}}</text>	
					</view>
					<view class="price-row" v-if="order?.order_type === 2">
						<text class="price-label">配送费</text>
						<text class="price-value">￥0.00</text>
					</view>
					<view class="total-row">
						<text class="total-label">实付金额</text>
						<text class="total-value">￥{{order?.total_price}}</text>	
					</view>
				</view>
			</view>

			<!-- 订单信息 -->
			<view class="card meta-card">
				<view class="card-title">
					<text class="title-text">订单信息</text>
				</view>
				<view class="meta-row">
					<text class="meta-label">订单编号</text>
					<text class="meta-value">{{order?.order_number || order?.id}}</text>	
				</view>
				<view class="meta-row">
					<text class="meta-label">下单时间</text>
					<text class="meta-value">{{formatDate(order?.createdAt ?? '')}}</text>	
				</view>
				<view class="meta-row">
					<text class="meta-label">支付方式</text>
					<text class="meta-value">微信支付</text>
				</view>
				<view class="meta-row" v-if="order?.remark">
					<text class="meta-label">订单备注</text>
					<text class="meta-value">{{order?.remark}}</text>
				</view>
			</view>

			<view style="height: 100rpx;"></view>
		</scroll-view>

		<!-- 底部操作栏 -->
		<view class="footer-bar">
			<view class="footer-left" v-if="order?.state === 0">
				<text class="footer-total-label">待支付</text>
				<text class="footer-total-price">￥{{order?.total_price}}</text>
			</view>
			<view class="footer-right">
				<view class="btn btn-outline" @click="contactService">
					<text class="btn-text">联系客服</text>
				</view>
				<view class="btn btn-primary" v-if="order?.state === 0 && !isOrderExpired()" @click="handlePay">	
					<text class="btn-text white-text">立即支付</text>
				</view>
				<view class="btn btn-primary" v-else-if="order?.state !== 0" @click="handleReorder">
					<text class="btn-text white-text">再来一单</text>
				</view>
			</view>
		</view>
	</view>
</template>

<script setup lang="uts">
	import { ref, onMounted, onUnmounted } from 'vue'
	import { onLoad } from '@dcloudio/uni-app'
	import { request } from '@/utils/request.uts'
	import { useCartStore, CartItem } from '@/store/cart.uts'
	import { useAppStore } from '@/store/app.uts'

	const appStore = useAppStore()

	const props = defineProps({
		id: {
			type: String,
			required: true
		}
	})

	const order = ref<any>(null)
	const isLoading = ref(false)
	const countdownText = ref('')
	let timer: any = null
	let orderId: number = 0

	onLoad((options: any) => {
		const idStr = options['id']
		if (idStr != null) {
			orderId = parseInt(idStr as string)
			fetchOrderDetail()
		}
	})

	onUnmounted(() => {
		if (timer) {
			clearInterval(timer)
			timer = null
		}
	})

	async function fetchOrderDetail() {
		if (orderId === 0) return
		isLoading.value = true
		try {
			const res = await request<any>({
				url: '/order/detail',
				method: 'GET',
				data: { id: orderId }
			})
			order.value = res.result
			
			// 如果是待支付状态，启动倒计时
			if (order.value?.state === 0 && order.value?.expire_time) {
				const expireDate = new Date(order.value.expire_time).getTime()
				const now = Date.now()
				if (expireDate - now > 0) {
					startCountdown()
				} else {
					countdownText.value = '00:00'
					// 如果已经过期但后端状态还没变，不需要疯狂刷新
					if (timer) {
						clearInterval(timer)
						timer = null
					}
				}
			} else {
				if (timer) {
					clearInterval(timer)
					timer = null
				}
			}
		} catch (e) {
			console.error(e)
			uni.showToast({ title: '获取详情失败', icon: 'none' })
		} finally {
			isLoading.value = false
		}
	}

	function startCountdown() {
		if (timer) clearInterval(timer)
		
		const expireDate = new Date(order.value.expire_time).getTime()
		
		const update = () => {
			const now = Date.now()
			const diff = Math.max(0, expireDate - now)
			
			if (diff <= 0) {
				if (timer) clearInterval(timer)
				timer = null
				countdownText.value = '00:00'
				// 倒计时结束，自动刷新订单状态。
				// 增加延迟刷新，防止后端异步状态变更延迟导致前端死循环
				setTimeout(() => {
					fetchOrderDetail()
				}, 3000)
				return
			}
			
			const m = Math.floor(diff / 1000 / 60)
			const s = Math.floor((diff / 1000) % 60)
			countdownText.value = `${m.toString().padStart(2, '0')}:${s.toString().padStart(2, '0')}`
		}
		
		update()
		timer = setInterval(update, 1000)
	}

	function formatStatus(state: number): string {
		if (state === 0 && isOrderExpired()) {
			return '已失效'
		}
		switch(state) {
			case 0: return '待支付'
			case 1: return '制作中'
			case 2: return '已完成'
			case 3: return '已评价'
			default: return '已取消'
		}
	}

	function getStatusDesc(state: number): string {
		if (state === 0 && isOrderExpired()) {
			return '订单支付超时，已自动失效'
		}
		switch(state) {
			case 0: return '请在规定时间内完成支付'
			case 1: return '正在为您精心制作中'
			case 2: return '订单已完成，期待再次光临'
			case 3: return '感谢您的评价'
			default: return '订单已取消'
		}
	}

	function isOrderExpired(): boolean {
		if (!order.value || order.value.state !== 0) return false
		const expireDate = getExpireDate()
		return Date.now() >= expireDate
	}

	function getExpireDate(): number {
		if (order.value?.expire_time) {
			return new Date(order.value.expire_time).getTime()
		}
		// 默认 15 分钟
		return new Date(order.value?.createdAt ?? Date.now()).getTime() + 15 * 60 * 1000
	}

	function getStatusClassSuffix(state: number): string {
		if (state === 0 && isOrderExpired()) {
			return 'expired'
		}
		switch(state) {
			case 0: return 'pending'
			case 1: return 'making'
			case 2: return 'completed'
			case 3: return 'rated'
			default: return 'cancelled'
		}
	}

	function getStatusIconType(state: number): string {
		if (state === 0 && isOrderExpired()) {
			return 'clear'
		}
		switch(state) {
			case 0: return 'wallet'
			case 1: return 'shop-filled'
			case 2: return 'checkbox-filled'
			case 3: return 'star-filled'
			default: return 'closeempty'
		}
	}

	function formatDate(dateStr: string): string {
		if (!dateStr) return ''
		const d = new Date(dateStr)
		return `${d.getFullYear()}-${(d.getMonth()+1).toString().padStart(2, '0')}-${d.getDate().toString().padStart(2, '0')} ${d.getHours().toString().padStart(2, '0')}:${d.getMinutes().toString().padStart(2, '0')}`
	}

	function contactService() {
		uni.showModal({
			title: '联系客服',
			content: '客服电话：400-xxx-xxxx',
			confirmText: '拨打',
			success: (res) => {
				if (res.confirm) {
					// uni.makePhoneCall({ phoneNumber: '400xxx' })
				}
			}
		})
	}

	async function cancelOrder() {
		uni.showModal({
			title: '提示',
			content: '确定要取消订单吗？',
			success: async (res) => {
				if (res.confirm) {
					uni.showLoading({ title: '处理中...' })
					try {
						// 尝试调用取消接口，如果后端没有，这步会失败
						await request<any>({
							url: '/order/cancel',
							method: 'POST',
							data: { id: order.value.id }
						})
						uni.hideLoading()
						uni.showToast({ title: '订单已取消', icon: 'success' })
						fetchOrderDetail()
					} catch (e) {
						uni.hideLoading()
						// 如果接口不存在，可能需要联系管理员
					}
				}
			}
		})
	}

	async function handlePay() {
		uni.showLoading({ title: '处理中...' })
		try {
			await request<any>({
				url: '/order/pay',
				method: 'POST',
				data: { id: order.value.id }
			})
			uni.hideLoading()
			uni.showToast({ title: '支付成功', icon: 'success' })
			fetchOrderDetail()
		} catch (e) {
			uni.hideLoading()
		}
	}

	function handleReorder() {
		const cartStore = useCartStore()
		const items = order.value.order_items as any[]
		cartStore.addReorderItems(items, appStore.currentStore?.id || 0)
	}

	function formatAddress(orderObj: any): string {
		if (!orderObj) return ''
		const info = (orderObj.address_info || (orderObj.address && typeof orderObj.address === 'object' ? orderObj.address : {})) as any

		const area = (info.area_name || orderObj.area_name || '') as string
		let detail = ''
		if (info.address && typeof info.address === 'string') {
			detail = info.address
		} else if (orderObj.address && typeof orderObj.address === 'string') {
			detail = orderObj.address
		} else {
			detail = '未提供详细地址'
		}

		return `${area} ${detail}`.trim()
	}

	function formatUserInfo(orderObj: any): string {
		if (!orderObj) return ''
		const info = (orderObj.address_info || (orderObj.address && typeof orderObj.address === 'object' ? orderObj.address : {})) as any

		const name = (info.consignee || orderObj.consignee || '未知联系人') as string
		const phone = (info.phone || orderObj.phone || '') as string
		return `${name} ${phone}`.trim()
	}
</script>

<style>
