		margin-bottom: 16rpx;
		text-shadow: 0 2rpx 4rpx rgba(0,0,0,0.1);
	}

	.status-desc {
		font-size: 26rpx;
		color: rgba(255, 255, 255, 0.9);
		line-height: 1.4;
	}

	.status-icon-box {
		width: 120rpx;
		height: 120rpx;
		display: flex;
		align-items: center;
		justify-content: center;
	}

	.status-decoration {
		position: absolute;
		right: -30rpx;
		bottom: -30rpx;
		z-index: 1;
		opacity: 0.15;
		transform: rotate(-15deg);
	}

	@keyframes status-pulse {
		0% { transform: scale(1); }
		50% { transform: scale(1.1); }
		100% { transform: scale(1); }
	}

	.status-bg-making .status-icon-box {
		animation: status-pulse 2s infinite ease-in-out;
	}

	.detail-content {
		flex: 1;
		margin-top: -60rpx;
		border-radius: 60rpx 60rpx 0 0;
		background-color: #f8f9fb;
		padding-top: 40rpx;
		position: relative;
		z-index: 3;
	}

	.card {
		background-color: #ffffff;
		border-radius: 24rpx;
		padding: 30rpx;
		margin: 0 30rpx 24rpx;
		box-shadow: 0 4rpx 20rpx rgba(0,0,0,0.02);
	}

	.card-title {
		border-bottom: 1rpx solid #f5f5f5;
		padding-bottom: 20rpx;
		margin-bottom: 24rpx;
	}

	.title-text {
		font-size: 28rpx;
		font-weight: bold;
		color: #333;
	}

	.info-row {
		display: flex;
		flex-direction: row;
		align-items: flex-start;
	}

	.info-label-box {
		width: 140rpx;
