		color: #333;
		margin-bottom: 8rpx;
		display: block;
	}

	.store-address, .user-info {
		font-size: 24rpx;
		color: #666;
		display: block;
	}

	.pickup-section {
		margin-top: 30rpx;
	}

	.pickup-divider {
		height: 1rpx;
		background-color: #f5f5f5;
		margin-bottom: 30rpx;
	}

	.pickup-content {
		display: flex;
