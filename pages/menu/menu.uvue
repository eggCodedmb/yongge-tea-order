<template>
	<view class="container">
		<!-- 顶部门店信息简栏 -->
		<view class="header">
			<view class="header-left">
				<text class="header-store-name">{{appStore.currentStore?.name}}</text>
				<text class="header-distance">距离您 {{formatDistance(appStore.currentStore?.distance)}}</text>
			</view>
			<view class="header-right">
				<view class="mode-switch">
					<text :class="['mode-text', appStore.orderMode === 'self-pickup' ? 'active' : '']" @click="appStore.setOrderMode('self-pickup')">自取</text>
					<text :class="['mode-text', appStore.orderMode === 'delivery' ? 'active' : '']" @click="appStore.setOrderMode('delivery')">外卖</text>
				</view>
			</view>
		</view>

		<!-- 主体内容：联动列表 -->
		<view class="main-content">
			<!-- 左侧分类 -->
			<scroll-view class="category-list" scroll-y>
				<view 
					v-for="(item, index) in categories" 
					:key="item.id" 
					:class="['category-item', activeCategoryIndex === index ? 'active' : '']"
					@click="selectCategory(index)"
				>
					<!-- 修正字段名：使用 category_name -->
					<text class="category-name">{{item.name}}</text>
				</view>
			</scroll-view>

			<!-- 右侧商品 -->
			<scroll-view class="product-list" scroll-y :scroll-into-view="scrollIntoView">
				<view v-for="(cat, catIdx) in categories" :key="cat.id" :id="'cat-' + catIdx" class="category-section">
					<view class="category-title">
						<text class="category-title-text">{{cat.name}}</text>
					</view>
					
					<!-- 优化状态展示 -->
					<view v-if="cat.loading" class="status-box">
						<text class="status-text">加载中...</text>
					</view>
					<view v-else-if="cat.products.length === 0" class="status-box">
						<text class="status-text">暂无商品</text>
					</view>
					
					<view v-else v-for="product in cat.products" :key="product.id" class="product-item" @click="goToDetail(product)">
						<image :src="formatImageUrl(product.image)" class="product-image" mode="aspectFill"></image>
						<view class="product-info">
							<text class="product-name">{{product.name}}</text>
							<text class="product-desc">{{product.desc}}</text>
							<view class="product-bottom">
								<text class="product-price">￥{{product.price}}</text>
								<view class="add-btn">
									<text class="add-btn-text">选规格</text>
								</view>
							</view>
						</view>
					</view>
				</view>
				<!-- 底部占位 -->
				<view style="height: 160rpx;"></view>
			</scroll-view>
		</view>

		<!-- 购物车悬浮条 -->
		<view class="cart-pill-bar" v-if="cartStore.totalCount > 0 && !isDetailPopupOpen" @click="toggleCartPopup">
			<view class="pill-left">
				<view class="cart-icon-box">
					<uni-icons type="cart-filled" size="30" color="#fff"></uni-icons>
					<view class="cart-pill-badge">
						<text class="pill-badge-text">{{cartStore.totalCount}}</text>
					</view>
				</view>
				<view class="pill-price-box">
					<text class="pill-total-price">￥{{cartStore.totalAmount}}</text>
					<text class="pill-desc">预估到手价格</text>
				</view>
			</view>
			<view class="pill-right" @click.stop="goToCheckout">
				<text class="settle-text">去结算</text>
				<uni-icons type="right" size="14" color="#fff"></uni-icons>
			</view>
		</view>

		<!-- 购物车抽屉弹窗 -->
		<uni-popup ref="cartPopup" type="bottom" background-color="transparent" :mask-click="true">
			<view class="cart-drawer-card">
				<!-- 顶部装饰手柄 -->
				<view class="drawer-header-bar">
					<view class="drawer-handle-line"></view>
				</view>

				<!-- 顶部：已选商品与清空按钮 -->
				<view class="drawer-header-content">
					<view class="drawer-header-left">
						<text class="drawer-title">已选商品</text>
						<text class="drawer-item-count">共 {{cartStore.totalCount}} 件</text>
					</view>
					<view class="drawer-clear-btn" @click="clearCart">
						<uni-icons type="trash" size="14" color="#999"></uni-icons>
						<text class="drawer-clear-text">清空</text>
					</view>
				</view>



				<!-- 商品列表区域 -->
				<scroll-view class="drawer-scroll-list" scroll-y>
					<view class="drawer-cart-item" v-for="(item, index) in cartStore.items" :key="index">
						<image :src="formatImageUrl(item.image)" class="item-pic" mode="aspectFill"></image>
						<view class="item-main-info">
							<view class="item-title-row">
								<text class="item-title-text">{{item.name}}</text>
								<text class="item-price-val">￥{{item.totalPrice}}</text>
							</view>
							<text class="item-spec-labels">{{item.specs.join('/')}}</text>
							<view class="item-footer-row">
								<view class="modern-stepper-control">
									<view class="stepper-btn-minus" @click="cartStore.decreaseQuantity(index)">
										<text class="stepper-icon-text">-</text>
									</view>
									<text class="stepper-count-val">{{item.quantity}}</text>
									<view class="stepper-btn-plus" @click="cartStore.increaseQuantity(index)">
										<text class="stepper-icon-text">+</text>
									</view>
								</view>
							</view>
						</view>
					</view>
				</scroll-view>
			</view>
		</uni-popup>

		<!-- 商品详情抽屉弹窗 (新加) -->
		<uni-popup ref="detailPopup" type="bottom" background-color="transparent" :mask-click="true">
			<view class="detail-drawer-card">
				<!-- 顶部装饰手柄 -->
				<view class="drawer-header-bar">
					<view class="drawer-handle-line"></view>
				</view>
				
				<scroll-view class="detail-drawer-scroll" scroll-y v-if="detailProduct != null">
					<!-- 商品大图 -->
					<image :src="formatImageUrl(detailProduct!.image)" class="detail-drawer-image" mode="aspectFill"></image>
					
					<view class="detail-drawer-content">
						<view class="detail-info-section">
							<text class="detail-product-name">{{detailProduct?.name}}</text>
							<text class="detail-product-desc">{{detailProduct?.desc}}</text>
						</view>
						
						<!-- 规格选择区 -->
						<view class="detail-spec-section" v-if="detailProduct!.specs.length > 0">
							<view v-for="spec in detailProduct!.specs" :key="spec.id" class="detail-spec-group">
								<text class="detail-spec-group-title">{{spec.name}}</text>
								<view class="detail-spec-options">
									<view 
										v-for="opt in spec.options" 
										:key="opt.id" 
										:class="['detail-spec-option', isSpecSelected(spec.name, opt.name) ? 'active' : '']"
										@click="selectSpec(spec.name, opt.name, opt.price_delta)"
									>
										<text :class="['detail-spec-option-text', isSpecSelected(spec.name, opt.name) ? 'active-text' : '']">
											{{opt.name}}{{opt.price_delta > 0 ? '(+' + opt.price_delta + ')' : ''}}
										</text>
									</view>
								</view>
							</view>
						</view>
						<view style="height: 40rpx;"></view>
					</view>
				</scroll-view>

				<!-- 详情底部加入购物车栏 -->
				<view class="detail-footer-bar" v-if="detailProduct != null">
					<view class="detail-footer-left">
						<text class="detail-footer-price">￥{{detailTotalPrice}}</text>
						<text class="detail-footer-specs">{{selectedSpecsValues.join('/')}}</text>
					</view>
					<view class="detail-add-cart-btn" @click="handleAddToCart">
						<text class="detail-add-cart-text">加入购物车</text>
					</view>
				</view>
			</view>
		</uni-popup>
	</view>
</template>

<script setup lang="uts">
	import { ref, onMounted, watch, computed } from 'vue'
	import { useAppStore } from '@/store/app.uts'
	import { useCartStore, CartItem } from '@/store/cart.uts'
	import { request, BASE_URL } from '@/utils/request.uts'
	import { formatDistance } from '@/utils/format.uts'

	interface Product {
		id: number;
		name: string;
		desc: string;
		price: number;
		image: string;
	}

	interface Category {
		id: number;
		name: string;
		products: Product[];
		loading: boolean;
	}

	// 详情相关接口
	interface SpecOption {
		id: number;
		name: string;
		price_delta: number;
	}

	interface SpecGroup {
		id: number;
		name: string;
		options: SpecOption[];
	}

	interface ProductDetail {
		id: number;
		name: string;
		desc: string;
		basePrice: number;
		image: string;
		specs: SpecGroup[];
	}

	const appStore = useAppStore()
	const cartStore = useCartStore()

	const categories = ref<Category[]>([])
	const activeCategoryIndex = ref(0)
	const scrollIntoView = ref('')
	const cartPopup = ref<any>(null)
	
	// 详情抽屉相关状态
	const detailPopup = ref<any>(null)
	const detailProduct = ref<ProductDetail | null>(null)
	const selectedSpecsMap = ref<UTSJSONObject>({})
	const selectedSpecsPriceMap = ref<UTSJSONObject>({})
	const isDetailPopupOpen = ref(false)

	onMounted(() => {
		fetchCategories()
	})

	
        watch(() => appStore.currentStore?.id, (newId) => {
                if (newId != null) {
                        fetchCategories()
                }
        })

	watch(() => cartStore.totalCount, (newCount) => {
		if (newCount === 0 && cartPopup.value != null) {
			cartPopup.value?.close()
		}
	})

	// 详情计算属性
	const selectedSpecsValues = computed(() : string[] => {
		const res : string[] = []
		const obj = selectedSpecsMap.value
		Object.keys(obj).forEach((key : string) => {
			res.push(obj[key] as string)
		})
		return res
	})

	const detailTotalPrice = computed(() : number => {
		let total = detailProduct.value?.basePrice || 0
		const obj = selectedSpecsPriceMap.value
		Object.keys(obj).forEach((key : string) => {
			total += (obj[key] as number)
		})
		return total
	})

	function onDetailPopupChange(e : UTSJSONObject) {
		isDetailPopupOpen.value = e['show'] as boolean
	}

	function toggleCartPopup() {
		if (cartStore.totalCount > 0) {
			if (cartPopup.value != null) {
				cartPopup.value?.open()
			}
		}
	}

	function clearCart() {
		uni.showModal({
			title: '提示',
			content: '确定清空购物车吗？',
			success: (res) => {
				if (res.confirm) {
					cartStore.clearCart()
					if (cartPopup.value != null) {
						cartPopup.value?.close()
					}
				}
			}
		})
	}

	async function fetchCategories() {
		try {
			const res = await request<any[]>({ url: '/category', data: { storeId: appStore.currentStore?.id } })
			// 修正映射：后端返回的是 category_name
			categories.value = res.result.map((item : any) : Category => {
				return {
					id: item.id,
					name: item.category_name || '未命名分类',
					products: [] as Product[],
					loading: false
				} as Category
			})
			
			if (categories.value.length > 0) {
				fetchAllProducts()
			}
		} catch (e) {
			console.error('Fetch categories failed', e)
		}
	}

	async function fetchAllProducts() {
		// 采用并发请求提高加载速度
		const promises : Promise<void>[] = []
		for (let i = 0; i < categories.value.length; i++) {
			promises.push(fetchProductsByCategory(i))
		}
		await Promise.all(promises)
	}

	async function fetchProductsByCategory(index: number) {
		const category = categories.value[index]
		category.loading = true
		try {
			const res = await request<any>({ url: `/category/${category.id}/goods`, data: { storeId: appStore.currentStore?.id } })
			const rawList = res.result.list as any[]
			
			// 强制触发响应式更新：通过重新赋值 items
			category.products = rawList.map((item : any) : Product => {
				return {
					id: item.id,
					name: item.goods_name, 
					desc: item.goods_detail || '', 
					price: parseFloat(item.goods_price || '0'),
					image: item.goods_img || ''
				} as Product
			})
		} catch (e) {
			console.error(`Fetch products for category ${category.id} failed`, e)
		} finally {
			category.loading = false
		}
	}

	function selectCategory(index: number) {
		activeCategoryIndex.value = index
		scrollIntoView.value = 'cat-' + index
		// 如果还没加载过，则触发加载
		if (categories.value[index].products.length === 0) {
			fetchProductsByCategory(index)
		}
	}

	function formatImageUrl(url: any): string {
		if (url == null || url == '') return '/static/logo.png' 
		const urlStr = url as string
		if (urlStr.startsWith('http')) return urlStr
		return BASE_URL + urlStr
	}

	async function goToDetail(product: Product) {
		// 1. 立即显示基础信息
		detailProduct.value = {
			id: product.id,
			name: product.name,
			desc: product.desc,
			basePrice: product.price,
			image: product.image,
			specs: [] as SpecGroup[]
		} as ProductDetail
		
		// 2. 打开抽屉
		detailPopup.value?.open()
		
		// 3. 异步获取完整详情
		fetchProductDetail(product.id)
	}

	async function fetchProductDetail(id: number) {
		try {
			const res = await request<any>({ url: `/goods/detail/${id}` })
			const raw = res.result
			
			const mappedSpecs = (raw.spec_groups || []).map((sg : any) : SpecGroup => {
				return {
					id: sg.id,
					name: sg.name,
					options: (sg.spec_options || []).map((so : any) : SpecOption => {
						return {
							id: so.id,
							name: so.name,
							price_delta: parseFloat(so.price_delta || '0')
						} as SpecOption
					})
				} as SpecGroup
			})

			const tempSpecsMap = {} as UTSJSONObject
			const tempPriceMap = {} as UTSJSONObject
			mappedSpecs.forEach((spec : SpecGroup) => {
				if (spec.options.length > 0) {
					tempSpecsMap[spec.name] = spec.options[0].name
					tempPriceMap[spec.name] = spec.options[0].price_delta
				}
			})

			selectedSpecsMap.value = tempSpecsMap
			selectedSpecsPriceMap.value = tempPriceMap

			detailProduct.value = {
				id: raw.id,
				name: raw.goods_name,
				desc: raw.goods_detail || '美味推荐',
				basePrice: parseFloat(raw.goods_price || '0'),
				image: raw.goods_img || '',
				specs: mappedSpecs
			} as ProductDetail
		} catch (e) {
			console.error('Fetch product detail failed', e)
		}
	}

	function isSpecSelected(specName: string, optionName: string): boolean {
		return selectedSpecsMap.value[specName] === optionName
	}

	function selectSpec(specName: string, optionName: string, priceDelta: number) {
		selectedSpecsMap.value[specName] = optionName
		selectedSpecsPriceMap.value[specName] = priceDelta
	}

	function handleAddToCart() {
		if (detailProduct.value == null) return
		
		const item: CartItem = {
			id: detailProduct.value!.id,
			cartId: 0,
			name: detailProduct.value!.name,
			price: detailTotalPrice.value, // 这里的 price 应该是包含规格的单价
			quantity: 1,
			specs: selectedSpecsValues.value,
			toppings: [],
			totalPrice: detailTotalPrice.value,
			image: detailProduct.value!.image,
			selected: true
		} as CartItem
		
		cartStore.addToCart(item)
		uni.showToast({ title: '已加入购物车', icon: 'success' })
		detailPopup.value?.close()
	}

	function goToCheckout() {
		uni.navigateTo({
			url: '/pages/checkout/checkout'
		})
	}
</script>

<style>
	.container {
		display: flex;
		flex-direction: column;
		height: 100vh;
		background-color: #fff;
	}

	.header {
		display: flex;
		flex-direction: row;
		justify-content: space-between;
		align-items: center;
		padding: 20rpx 30rpx;
		border-bottom: 1rpx solid #eee;
	}

	.header-left {
		display: flex;
		flex-direction: column;
	}

	.header-store-name {
		font-size: 30rpx;
		font-weight: bold;
		color: #333;
	}

	.header-distance {
		font-size: 22rpx;
		color: #999;
	}

	.mode-switch {
		display: flex;
		flex-direction: row;
		background-color: #f5f5f5;
		border-radius: 30rpx;
		padding: 4rpx;
	}

	.mode-text {
		padding: 10rpx 30rpx;
		font-size: 24rpx;
		border-radius: 26rpx;
		color: #666;
	}

	.mode-text.active {
		background-color: #00cc99;
		color: #fff;
	}

	.main-content {
		flex: 1;
		display: flex;
		flex-direction: row;
		overflow: hidden;
	}

	.category-list {
		width: 180rpx;
		height: 100%;
		background-color: #f8f8f8;
	}

	.category-item {
		padding: 40rpx 20rpx;
		display: flex;
		justify-content: center;
		align-items: center;
	}

	.category-item.active {
		background-color: #fff;
	}

	.category-name {
		font-size: 26rpx;
		color: #666;
		text-align: center;
	}

	.category-item.active .category-name {
		color: #333;
		font-weight: bold;
	}

	.product-list {
		flex: 1;
		height: 100%;
		padding: 0 20rpx;
	}

	.category-title {
		padding: 20rpx 0;
	}

	.category-title-text {
		font-size: 24rpx;
		color: #999;
	}

	.product-item {
		display: flex;
		flex-direction: row;
		padding: 20rpx 0;
	}

	.product-image {
		width: 160rpx;
		height: 160rpx;
		border-radius: 12rpx;
		margin-right: 20rpx;
		background-color: #f0f0f0;
	}

	.product-info {
		flex: 1;
		display: flex;
		flex-direction: column;
		justify-content: space-between;
	}

	.product-name {
		font-size: 30rpx;
		font-weight: bold;
		color: #333;
	}

	.product-desc {
		font-size: 22rpx;
		color: #999;
		margin: 10rpx 0;
		lines: 1;
		text-overflow: ellipsis;
	}

	.product-bottom {
		display: flex;
		flex-direction: row;
		justify-content: space-between;
		align-items: center;
	}

	.product-price {
		font-size: 32rpx;
		color: #ff4d4f;
		font-weight: bold;
	}

	.add-btn {
		background-color: #00cc99;
		padding: 6rpx 20rpx;
		border-radius: 24rpx;
	}

	.add-btn-text {
		color: #fff;
		font-size: 22rpx;
	}

	.status-box {
		padding: 60rpx 0;
		display: flex;
		align-items: center;
		justify-content: center;
	}

	.status-text {
		font-size: 24rpx;
		color: #ccc;
	}

	/* 现代化购物车悬浮条 */
	.cart-pill-bar {
		position: fixed;
		bottom: 30rpx;
		left: 30rpx;
		right: 30rpx;
		height: 110rpx;
		background-color: rgba(51, 51, 51, 0.95);
		border-radius: 60rpx;
		display: flex;
		flex-direction: row;
		align-items: center;
		justify-content: space-between;
		padding: 0 10rpx 0 40rpx;
		z-index: 90;
		box-shadow: 0 16rpx 40rpx rgba(0,0,0,0.3);
		overflow: visible;
		/* #ifdef APP-ANDROID || APP-IOS */
		backdrop-filter: blur(10px);
		/* #endif */
	}

	.pill-left {
		display: flex;
		flex-direction: row;
		align-items: center;
		overflow: visible;
	}

	.cart-icon-box {
		position: relative;
		margin-right: 30rpx;
		overflow: visible;
	}

	.cart-icon-box.empty {
		opacity: 0.6;
	}

	.cart-pill-badge {
		position: absolute;
		top: -10rpx;
		right: -10rpx;
		background-color: #ff4d4f;
		min-width: 36rpx;
		height: 36rpx;
		border-radius: 18rpx;
		display: flex;
		align-items: center;
		justify-content: center;
		border: 4rpx solid #333;
		z-index: 120;
	}

	.pill-badge-text {
		color: #fff;
		font-size: 20rpx;
		font-weight: bold;
	}

	.pill-price-box {
		display: flex;
		flex-direction: column;
	}

	.pill-total-price {
		color: #fff;
		font-size: 38rpx;
		font-weight: bold;
		line-height: 1;
	}

	.pill-desc {
		color: rgba(255,255,255,0.5);
		font-size: 20rpx;
		margin-top: 4rpx;
	}

	.pill-empty-text {
		color: rgba(255,255,255,0.8);
		font-size: 28rpx;
		font-weight: 500;
	}

	.pill-right {
		background-color: #00cc99;
		height: 90rpx;
		padding: 0 40rpx;
		border-radius: 45rpx;
		display: flex;
		flex-direction: row;
		align-items: center;
		justify-content: center;
	}

	.pill-right.disabled {
		background-color: rgba(255,255,255,0.1);
	}

	.settle-text {
		color: #fff;
		font-size: 30rpx;
		font-weight: bold;
		margin-right: 4rpx;
	}

	.settle-text.muted {
		color: rgba(255,255,255,0.3);
	}

	/* 彻底重构的现代化购物车抽屉 */
	.cart-drawer-card {
