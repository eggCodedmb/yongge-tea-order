<template>
	<view class="page-wrapper">
		<scroll-view class="detail-scroll" scroll-y v-if="product != null">
			<!-- 商品大图 -->
			<image :src="formatImageUrl(product!.image)" class="product-image" mode="aspectFill"></image>
			
			<view class="content-box">
				<view class="info-section">
					<text class="product-name">{{product?.name}}</text>
					<text class="product-desc">{{product?.desc}}</text>
					<text class="product-price">￥{{currentTotalPrice}}</text>
				</view>
				
				<!-- 规格选择区 -->
				<view class="spec-section" v-if="specs.length > 0">
					<view v-for="spec in specs" :key="spec.id" class="spec-group">
						<view class="spec-group-header">
							<text class="spec-group-title">{{spec.name}}</text>
							<view class="spec-group-tags">
								<text class="spec-tag required" v-if="spec.is_required">必选</text>
								<text class="spec-tag multiple" v-if="spec.select_type === 'multiple'">多选</text>
							</view>
						</view>
						<view class="spec-options">
							<view 
								v-for="opt in spec.options" 
								:key="opt.id" 
								:class="['spec-option', isSpecSelected(spec.name, opt.name) ? 'active' : '']"
								@click="selectSpec(spec.name, opt.name, opt.price_delta)"
							>
								<text :class="['spec-option-text', isSpecSelected(spec.name, opt.name) ? 'active-text' : '']">
									{{opt.name}}{{opt.price_delta > 0 ? '(+' + opt.price_delta + ')' : ''}}
								</text>
							</view>
						</view>
					</view>
				</view>
				
				<view style="height: 160rpx;"></view>
			</view>
		</scroll-view>
		
		<view class="loading-full" v-else>
			<text class="loading-text">正在加载详情...</text>
		</view>

		<!-- 底部加入购物车栏 -->
		<view class="footer-bar" v-if="product != null">
			<view class="footer-left">
				<text class="footer-price">￥{{currentTotalPrice}}</text>
				<text class="footer-specs">{{selectedSpecsValues.join('/')}}</text>
			</view>
			<view class="add-cart-btn" @click="handleAddToCart">
				<text class="add-cart-text">加入购物车</text>
			</view>
		</view>
	</view>
</template>
<script setup lang="uts">
	import { ref, computed } from 'vue'
	import { onLoad } from '@dcloudio/uni-app'
	import { useCartStore, CartItem } from '@/store/cart.uts'
	import { request, STATIC_URL } from '@/utils/request.uts'

	interface SpecOption {
		id: number;
		name: string;
		price_delta: number;
		is_default: boolean;
	}

	interface SpecGroup {
		id: number;
		name: string;
		select_type: string; // single | multiple
		is_required: boolean;
		options: SpecOption[];
	}

	interface ProductDetail {
		id: number;
		name: string;
		desc: string;
		basePrice: number;
		image: string;
		specs: SpecGroup[];
	}

	const cartStore = useCartStore()
	const product = ref<ProductDetail | null>(null)
	
	// 使用普通对象配合 ref 确保在 UTS 中的响应式更可靠
	const selectedSpecsMap = ref<UTSJSONObject>({})
	const selectedSpecsPriceMap = ref<UTSJSONObject>({})

	const specs = computed(() : SpecGroup[] => {
		return product.value?.specs || [] as SpecGroup[]
	})

	onLoad((options: any) => {
		const id = options['id']
		if (id == null) return

		const productId = parseInt(id as string)
		
		// 1. 尝试从缓存中提取基础信息先显示，防止页面“分块”显示
		const data = uni.getStorageSync('current_product') as string
		if (data != '') {
			try {
				const basicInfo = JSON.parse(data) as UTSJSONObject
				if (basicInfo != null && basicInfo['id'] == productId) {
					// 填充基础字段，specs 先设为空
					product.value = {
						id: productId,
						name: basicInfo['name'] as string,
						desc: basicInfo['desc'] as string,
						basePrice: basicInfo['price'] as number,
						image: basicInfo['image'] as string,
						specs: [] as SpecGroup[]
					} as ProductDetail
				}
			} catch (e) {
				console.error('Parse cached product failed', e)
			}
		}

		// 2. 异步获取完整详情（规格等）
		fetchProductDetail(productId)
	})

	async function fetchProductDetail(id: number) {
		try {
			const res = await request<any>({ url: `/goods/detail/${id}` })
			const raw = res.result
			
			// 严格映射后端 spec_groups -> SpecGroup
			const mappedSpecs = (raw.spec_groups || []).map((sg : any) : SpecGroup => {
				return {
					id: sg.id,
					name: sg.name,
					select_type: sg.select_type || 'single',
					is_required: sg.is_required !== undefined ? sg.is_required : true,
					// 严格映射后端 spec_options -> SpecOption
					options: (sg.spec_options || []).map((so : any) : SpecOption => {
						return {
							id: so.id,
							name: so.name,
							price_delta: parseFloat(so.price_delta || '0'),
							is_default: so.is_default || false
						} as SpecOption
					})
				} as SpecGroup
			})

			// 准备规格默认选择
			const tempSpecsMap = {} as UTSJSONObject
			const tempPriceMap = {} as UTSJSONObject
			mappedSpecs.forEach((spec : SpecGroup) => {
				if (spec.select_type === 'single') {
					// 单选：找标记为默认的，没有则不选（如果非必选）或选第一个（如果必选）
					const defaultOpt = spec.options.find(opt => opt.is_default)
					if (defaultOpt != null) {
						tempSpecsMap[spec.name] = defaultOpt.name
						tempPriceMap[spec.name] = defaultOpt.price_delta
					} else if (spec.is_required && spec.options.length > 0) {
						tempSpecsMap[spec.name] = spec.options[0].name
						tempPriceMap[spec.name] = spec.options[0].price_delta
					}
				} else {
					// 多选：找出所有标记为默认的
					const defaultOpts = spec.options.filter(opt => opt.is_default)
					const names = defaultOpts.map(opt => opt.name)
					const price = defaultOpts.reduce((sum, opt) => sum + opt.price_delta, 0)
					tempSpecsMap[spec.name] = names
					tempPriceMap[spec.name] = price
				}
			})

			// 统一更新状态
			selectedSpecsMap.value = tempSpecsMap
			selectedSpecsPriceMap.value = tempPriceMap

			product.value = {
				id: raw.id,
				name: raw.goods_name,
				desc: raw.goods_detail || '美味推荐',
				basePrice: parseFloat(raw.goods_price || '0'),
				image: raw.goods_img || '',
				specs: mappedSpecs
			} as ProductDetail
		} catch (e) {
			console.error('Fetch product detail failed', e)
		}
	}

	const selectedSpecsValues = computed(() : string[] => {
		const res : string[] = []
		const obj = selectedSpecsMap.value
		Object.keys(obj).forEach((key : string) => {
			const val = obj[key]
			if (Array.isArray(val)) {
				(val as string[]).forEach(v => {
					if (v != '') res.push(v)
				})
			} else if (val != null && val != '') {
				res.push(val as string)
			}
		})
		return res
	})

	const selectedSpecIds = computed(() : number[] => {
		const ids : number[] = []
		const obj = selectedSpecsMap.value
		
		Object.keys(obj).forEach((specName : string) => {
			const val = obj[specName]
			const specGroup = product.value?.specs.find(s => s.name === specName)
			if (specGroup != null) {
				if (Array.isArray(val)) {
					(val as string[]).forEach(optName => {
						const opt = specGroup.options.find(o => o.name === optName)
						if (opt != null) ids.push(opt.id)
					})
				} else if (val != null && val != '') {
					const opt = specGroup.options.find(o => o.name === (val as string))
					if (opt != null) ids.push(opt.id)
				}
			}
		})
		return ids
	})

	const currentTotalPrice = computed(() : number => {
		let total = product.value?.basePrice || 0
		const obj = selectedSpecsPriceMap.value
		Object.keys(obj).forEach((key : string) => {
			total += (obj[key] as number)
		})
		return total
	})

	function isSpecSelected(specName: string, optionName: string): boolean {
		const val = selectedSpecsMap.value[specName]
		if (Array.isArray(val)) {
			return (val as string[]).includes(optionName)
		}
		return val === optionName
	}

	function selectSpec(specName: string, optionName: string, priceDelta: number) {
		const spec = specs.value.find(s => s.name === specName)
		if (spec == null) return

		if (spec.select_type === 'single') {
			// 单选切换
			if (selectedSpecsMap.value[specName] === optionName) {
				// 如果是非必选，允许反选
				if (!spec.is_required) {
					delete selectedSpecsMap.value[specName]
					delete selectedSpecsPriceMap.value[specName]
				}
			} else {
				selectedSpecsMap.value[specName] = optionName
				selectedSpecsPriceMap.value[specName] = priceDelta
			}
		} else {
			// 多选切换
			let currentNames = (selectedSpecsMap.value[specName] as string[] | null) || []
			const idx = currentNames.indexOf(optionName)
			if (idx > -1) {
				currentNames.splice(idx, 1)
			} else {
				currentNames.push(optionName)
			}
			
			// 重新计算该组总价
			let groupPrice = 0
			currentNames.forEach(name => {
				const opt = spec.options.find(o => o.name === name)
				if (opt != null) groupPrice += opt.price_delta
			})
			
			selectedSpecsMap.value[specName] = currentNames
			selectedSpecsPriceMap.value[specName] = groupPrice
		}
	}

	function formatImageUrl(url: string): string {
		let urlStr = url
		if (urlStr.includes('127.0.0.1:8800') || urlStr.includes('localhost:8800')) {
			urlStr = urlStr.replace('http://127.0.0.1:8800', '').replace('http://localhost:8800', '')
		}
		if (urlStr != '' && urlStr.startsWith('http')) return urlStr
		if (urlStr == '') return '/static/logo.png'
		const cleanUrl = urlStr.startsWith('/') ? urlStr : '/' + urlStr
		return STATIC_URL + cleanUrl
	}

	function handleAddToCart() {
		if (product.value == null) return
		
		// 必选校验
		for (const spec of specs.value) {
			if (spec.is_required) {
				const val = selectedSpecsMap.value[spec.name]
				if (val == null || (Array.isArray(val) && (val as string[]).length === 0) || val === '') {
					uni.showToast({ title: `请选择${spec.name}`, icon: 'none' })
					return
				}
			}
		}
		
		const item: CartItem = {
			id: product.value!.id,
			cartId: 0,
			name: product.value!.name,
			price: currentTotalPrice.value, 
			quantity: 1,
			specs: selectedSpecsValues.value,
			spec_ids: selectedSpecIds.value, // 修正字段名：使用 spec_ids
			toppings: [],
			totalPrice: currentTotalPrice.value,
			image: product.value!.image,
			selected: true
		} as CartItem
		
		cartStore.addToCart(item)
		uni.showToast({ title: '已加入购物车', icon: 'success' })
		setTimeout(() => {
			uni.navigateBack()
		}, 1000)
	}
</script>

<style>
	.page-wrapper {
		display: flex;
		flex-direction: column;
		height: 100vh;
		background-color: #fff;
	}

	.detail-scroll {
		flex: 1;
		height: 100%;
	}

	.product-image {
		width: 100%;
		height: 600rpx;
		background-color: #f8f8f8;
	}

	.content-box {
		padding: 30rpx;
	}

	.info-section {
		margin-bottom: 40rpx;
	}

	.product-name {
		font-size: 44rpx;
		font-weight: bold;
		color: #333;
		display: block;
	}

	.product-desc {
		font-size: 28rpx;
		color: #999;
		margin-top: 20rpx;
		display: block;
	}

	.product-price {
		font-size: 48rpx;
		color: #ff4d4f;
		font-weight: bold;
		margin-top: 30rpx;
		display: block;
	}

	.spec-section {
		border-top: 1rpx solid #f5f5f5;
		padding-top: 40rpx;
	}

	.spec-group {
		margin-bottom: 40rpx;
	}

	.spec-group-title {
		font-size: 30rpx;
		font-weight: bold;
		color: #333;
		display: block;
	}

	.spec-group-header {
		display: flex;
		flex-direction: row;
		align-items: center;
		margin-bottom: 24rpx;
	}

	.spec-group-tags {
		display: flex;
		flex-direction: row;
		margin-left: 20rpx;
	}

	.spec-tag {
		font-size: 20rpx;
		padding: 4rpx 12rpx;
		border-radius: 6rpx;
		margin-right: 10rpx;
	}

	.spec-tag.required {
		background-color: #fff1f0;
		color: #ff4d4f;
		border: 1rpx solid #ffccc7;
	}

	.spec-tag.multiple {
		background-color: #f6ffed;
		color: #52c41a;
		border: 1rpx solid #b7eb8f;
	}

	.spec-options {
		display: flex;
		flex-direction: row;
		flex-wrap: wrap;
	}

	.spec-option {
		background-color: #f8f8f8;
		padding: 16rpx 30rpx;
		border-radius: 12rpx;
		margin-right: 20rpx;
		margin-bottom: 20rpx;
		border: 1rpx solid transparent;
		display: flex;
		align-items: center;
		justify-content: center;
	}

	.spec-option.active {
		background-color: #e6f9f5;
		border-color: #00cc99;
	}

	.spec-option-text {
		font-size: 26rpx;
		color: #666;
	}

	.active-text {
		color: #00cc99;
		font-weight: bold;
	}

	.footer-bar {
		position: fixed;
		bottom: 0;
		left: 0;
		right: 0;
		background-color: #fff;
		display: flex;
		flex-direction: row;
		align-items: center;
		padding: 20rpx 40rpx;
		padding-bottom: calc(20rpx + constant(safe-area-inset-bottom));
		padding-bottom: calc(20rpx + env(safe-area-inset-bottom));
		box-shadow: 0 -2rpx 20rpx rgba(0,0,0,0.05);
		z-index: 100;
	}

	.footer-left {
		flex: 1;
		display: flex;
		flex-direction: column;
	}

	.footer-price {
		font-size: 40rpx;
		color: #ff4d4f;
		font-weight: bold;
	}

	.footer-specs {
		font-size: 22rpx;
		color: #999;
	}

	.add-cart-btn {
		background-color: #00cc99;
		width: 260rpx;
		height: 88rpx;
		border-radius: 44rpx;
		display: flex;
		align-items: center;
		justify-content: center;
	}

	.add-cart-text {
		color: #fff;
		font-size: 32rpx;
		font-weight: bold;
	}
	
	.loading-full {
		flex: 1;
		display: flex;
		align-items: center;
		justify-content: center;
		padding-top: 200rpx;
	}

	.loading-text {
		color: #999;
		font-size: 28rpx;
	}
</style>