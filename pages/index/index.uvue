<template>
	<view class="container">
		<!-- 轮播图 -->
		<swiper class="banner" indicator-dots autoplay interval="3000" duration="500">
			<swiper-item v-for="(item, index) in banners" :key="index">
				<image :src="item" class="banner-image" mode="aspectFill"></image>
			</swiper-item>
		</swiper>

		<!-- 门店信息 -->
		<view class="store-info card" @click="goToStoreList">
			<view class="store-name-row">
				<text class="store-name">{{appStore.currentStore?.name}}</text>
				<view class="distance-tag">
					<text class="distance-text">距离您 {{formatDistance(appStore.currentStore?.distance)}}</text>
				</view>
			</view>
			<view class="store-address-row">
				<text class="store-address">{{appStore.currentStore?.address}}</text>
			</view>
		</view>

		<!-- 点单大入口 -->
		<view class="entry-row">
			<view class="entry-card left-card" @click="goToMenu('self-pickup')">
				<image src="/static/pickup.png" class="entry-icon"></image>
				<text class="entry-title">门店自取</text>
				<text class="entry-desc">下单免排队</text>
			</view>
			<view class="entry-card right-card" @click="goToMenu('delivery')">
				<image src="/static/delivery.png" class="entry-icon"></image>
				<text class="entry-title">外卖配送</text>
				<text class="entry-desc">送到您手中</text>
			</view>
		</view>

		<!-- 签到卡片 -->
		<view v-if="userStore.token" class="checkin-card card">
			<view class="checkin-header" @click="goToCheckin">
				<view class="checkin-header-left">
					<text class="checkin-title">📅 每日签到</text>
					<text class="checkin-streak" v-if="checkinStatus.streak > 0">已连续签到 {{checkinStatus.streak}} 天</text>
				</view>
				<text class="checkin-arrow">></text>
			</view>
			<view class="checkin-dots-row">
				<view
					v-for="(day, idx) in checkinDays"
					:key="idx"
					class="checkin-dot-item"
				>
					<view
						class="checkin-dot"
						:class="{
							'dot-checked': day.checked,
							'dot-today': day.isToday,
							'dot-future': !day.checked && !day.isToday
						}"
					>
						<text class="dot-label">{{day.checked ? '✓' : day.dayNum}}</text>
					</view>
					<text class="dot-day-text">{{day.dayLabel}}</text>
				</view>
			</view>
			<view
				class="checkin-btn"
				:class="{'btn-disabled': checkinStatus.todayCheckedIn}"
				@click.stop="handleCheckin"
			>
				<text class="checkin-btn-text">{{checkinStatus.todayCheckedIn ? '今日已签到 ✓' : '立即签到'}}</text>
			</view>
		</view>

		<!-- 快捷入口 -->
		<view class="quick-nav card">
			<view class="nav-item" @click="goToCoupon">
				<text class="nav-icon">🎟️</text>
				<text class="nav-text">我的卡券</text>
			</view>
			<view class="nav-item">
				<text class="nav-icon">🏆</text>
				<text class="nav-text">积分商城</text>
			</view>
		</view>
	</view>
</template>

<script setup lang="uts">
	import { ref, computed, onMounted } from 'vue'
	import { request } from '@/utils/request.uts'
	import { StoreInfo } from '@/store/app.uts'
	import { useAppStore } from '@/store/app.uts'
	import { useUserStore } from '@/store/user.uts'
	import { formatDistance } from '@/utils/format.uts'

	const appStore = useAppStore()
	const userStore = useUserStore()

	const banners = ref([
		'/static/banner/banner1.jpg',
		'/static/banner/banner2.jpg',
		'/static/banner/banner3.jpg'
	])

	// 签到状态
	const checkinStatus = ref({
		streak: 0,
		todayCheckedIn: false,
		nextDayNumber: 1,
		rewards: [] as any[],
		history: [] as any[]
	})

	// 构建7天显示数据
	const checkinDays = computed(() => {
		const days: UTSJSONObject[] = []
		const history = checkinStatus.value.history || [] as any[]
		const checkedDays = new Set<number>()
		for (let i = 0; i < history.length; i++) {
			const h = history[i] as UTSJSONObject
			checkedDays.add(h['day_number'] as number)
		}
		const dayLabels = ['1', '2', '3', '4', '5', '6', '7']
		const nextDay = checkinStatus.value.nextDayNumber
		for (let i = 1; i <= 7; i++) {
			days.push({
				dayNum: dayLabels[i - 1],
				dayLabel: '第' + i + '天',
				checked: checkedDays.has(i),
				isToday: !checkinStatus.value.todayCheckedIn && i === nextDay
			} as UTSJSONObject)
		}
		return days
	})

	onMounted(() => {
		if (!appStore.currentStore) {
			getNearestStore()
		}
		if (userStore.token) {
			fetchCheckinStatus()
		}
	})

	async function fetchCheckinStatus() {
		try {
			const res = await request<any>({ url: '/checkin/status', method: 'GET' })
			checkinStatus.value = res.result as any
		} catch (e) {
			console.error('获取签到状态失败', e)
		}
	}

	async function handleCheckin() {
		if (checkinStatus.value.todayCheckedIn) return
		try {
			await request<any>({ url: '/checkin', method: 'POST' })
			await fetchCheckinStatus()
			uni.showToast({ title: '签到成功', icon: 'success' })
		} catch (e) {
			console.error('签到失败', e)
		}
	}

	function goToCheckin() {
		uni.navigateTo({ url: '/pages/checkin/checkin' })
	}

	function goToCoupon() {
		uni.navigateTo({ url: '/pages/coupon/coupon' })
	}

	function getNearestStore() {
		uni.getLocation({
			type: 'gcj02',
			success: (res) => {
				request<any>({
					url: '/store/nearby',
					data: {
						longitude: res.longitude,
						latitude: res.latitude,
						pageSize: 1
					}
				}).then(data => {
					const list = data.result.list as StoreInfo[]
					if (list.length > 0) {
						appStore.setStore(list[0])
					}
				})
			},
			fail: () => {
				request<any>({
					url: '/store/all',
					data: { pageSize: 1 }
				}).then(data => {
					const list = data.result.list as StoreInfo[]
					if (list.length > 0) {
						appStore.setStore(list[0])
					}
				})
			}
		})
	}

	function goToStoreList() {
		uni.navigateTo({
			url: '/pages/store/list'
		})
	}

	function goToMenu(mode: string) {
		appStore.setOrderMode(mode as 'self-pickup' | 'delivery')
		uni.switchTab({
			url: '/pages/menu/menu'
		})
	}
</script>

<style>
	.container {
		background-color: #f5f5f5;
		min-height: 100vh;
		padding-bottom: 20px;
	}

	.banner {
		width: 100%;
		height: 450rpx;
	}

	.banner-image {
		width: 100%;
		height: 100%;
	}

	.card {
		background-color: #ffffff;
		margin: 20rpx;
		padding: 30rpx;
		border-radius: 16rpx;
	}

	.store-info {
		margin-top: -40rpx;
		position: relative;
		z-index: 1;
	}

	.store-name-row {
		flex-direction: row;
		justify-content: space-between;
		align-items: center;
		margin-bottom: 10rpx;
	}

