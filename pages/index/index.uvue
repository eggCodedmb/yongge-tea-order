		font-size: 32rpx;
		font-weight: bold;
		color: #333333;
	}

	.distance-tag {
		background-color: #e6f9f5;
		padding: 4rpx 12rpx;
		border-radius: 20rpx;
	}

	.distance-text {
		font-size: 22rpx;
		color: #00cc99;
	}

	.store-address {
		font-size: 24rpx;
		color: #999999;
	}

	.entry-row {
		flex-direction: row;
		padding: 0 10rpx;
	}

	.entry-card {
		flex: 1;
		background-color: #ffffff;
		margin: 10rpx;
		padding: 40rpx 20rpx;
		border-radius: 16rpx;
		align-items: center;
		justify-content: center;
	}

	.entry-icon {
		width: 80rpx;
		height: 80rpx;
		margin-bottom: 20rpx;
	}

	.entry-title {
		font-size: 36rpx;
		font-weight: bold;
		color: #333333;
		margin-bottom: 10rpx;
	}

	.entry-desc {
		font-size: 24rpx;
		color: #999999;
	}

	.quick-nav {
		flex-direction: row;
		justify-content: space-around;
	}

	.nav-item {
		align-items: center;
	}

	.nav-icon {
		font-size: 50rpx;
		margin-bottom: 10rpx;
	}

	.nav-text {
		font-size: 24rpx;
		color: #666666;
	}

	/* ---- 签到卡片 ---- */
	.checkin-card {
		padding: 24rpx 30rpx;
	}

	.checkin-header {
		flex-direction: row;
		justify-content: space-between;
		align-items: center;
		margin-bottom: 24rpx;
	}

	.checkin-header-left {
		flex-direction: column;
	}

	.checkin-title {
		font-size: 30rpx;
		font-weight: bold;
		color: #333333;
	}

	.checkin-streak {
		font-size: 22rpx;
		color: #00CC99;
		margin-top: 6rpx;
	}

	.checkin-arrow {
		font-size: 28rpx;
		color: #cccccc;
	}

	.checkin-dots-row {
		flex-direction: row;
		justify-content: space-between;
		align-items: center;
		margin-bottom: 24rpx;
	}

	.checkin-dot-item {
		align-items: center;
		flex: 1;
	}

	.checkin-dot {
		width: 60rpx;
		height: 60rpx;
		border-radius: 30rpx;
		justify-content: center;
		align-items: center;
		margin-bottom: 8rpx;
	}

	.dot-checked {
		background-color: #00CC99;
	}

	.dot-today {
		background-color: #ffffff;
		border-width: 3rpx;
		border-color: #00CC99;
		border-style: solid;
	}

	.dot-future {
		background-color: #e6f9f5;
	}

	.dot-label {
		font-size: 24rpx;
		font-weight: bold;
	}

	.dot-checked .dot-label {
		color: #ffffff;
	}

	.dot-today .dot-label {
		color: #00CC99;
	}

	.dot-future .dot-label {
		color: #999999;
	}

	.dot-day-text {
		font-size: 18rpx;
		color: #999999;
	}

	.checkin-btn {
		background: linear-gradient(135deg, #00CC99 0%, #00E6A7 100%);
		border-radius: 44rpx;
		height: 80rpx;
		justify-content: center;
		align-items: center;
	}

	.btn-disabled {
		background: #cccccc;
	}

	.checkin-btn-text {
		font-size: 30rpx;
		font-weight: bold;
		color: #ffffff;
	}
</style>