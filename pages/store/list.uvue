<template>
	<view class="container">
		<view class="search-bar">
			<uni-search-bar radius="100" placeholder="搜索门店" clearButton="auto" cancelButton="none" @confirm="search" @input="onInput" @clear="clearSearch" @cancel="clearSearch" />
		</view>

		<!-- 地图区域 -->
		<view class="map-wrapper">
			<map
				id="storeMap"
				class="store-map"
				:longitude="mapLongitude"
				:latitude="mapLatitude"
				:scale="mapScale"
				:markers="mapMarkers"
				:circles="mapCircles"
				:show-location="hasLocation"
				:enable-zoom="true"
				:enable-scroll="true"
				:enable-rotate="false"
				@markertap="onMarkerTap"
				@callouttap="onCalloutTap"
			></map>
			<!-- 重新定位按钮 -->
			<view
				:class="['relocate-btn', drawerState === 'expanded' ? 'relocate-btn-up' : '']"
				@click="relocate"
			>
				<uni-icons type="refresh" size="14" color="#00cc99" style="margin-right: 8rpx;"></uni-icons>
				<text class="relocate-text">重新定位</text>
			</view>
			<!-- 定位状态提示 -->
			<view v-if="locationLoading" class="location-loading">
				<text class="loading-text">定位中...</text>
			</view>
		</view>

		<!-- 底部滑动抽屉容器 -->
		<view
			class="drawer-container"
			:class="[drawerState === 'expanded' ? 'drawer-expanded' : 'drawer-collapsed']"
			@touchstart="onTouchStart"
			@touchmove="onTouchMove"
			@touchend="onTouchEnd"
		>


			<!-- 门店列表 -->
			<scroll-view
				class="store-list"
				:scroll-y="drawerState === 'expanded'"
				:scroll-into-view="scrollToView"
				@scroll="onScroll"
			>
				<view
					v-for="(item, index) in stores"
					:key="item.id"
					:id="'store-' + item.id"
					:class="['store-item', 'card', selectedStoreId === item.id ? 'card-active' : '']"
					@click="selectedStoreId = item.id"
				>
					<view class="store-main">
						<view class="store-info">
							<!-- 门店名称 -->
							<view class="store-name-row">
								<text class="store-name">{{item.name}}</text>
								<text v-if="selectedStoreId === item.id" class="current-tag">当前</text>
							</view>
							
							<!-- 距离、营业状态和标签 -->
							<view class="store-meta-row">
								<text class="distance">{{formatDistance(item.distance)}}</text>
								<text :class="['status-tag', isStoreOpen(item.business_hours) ? 'status-open' : 'status-closed']">
									{{ isStoreOpen(item.business_hours) ? '营业中' : '休息中' }}
								</text>
								<text class="badge-tag">自提</text>
								<text class="badge-tag">外卖</text>
							</view>

							<!-- 地址 -->
							<view class="store-detail-row">
								<uni-icons type="location" size="14" color="#999999" style="margin-right: 8rpx; margin-top: 2rpx;"></uni-icons>
								<text class="store-address">{{item.address}}</text>
							</view>

							<!-- 营业时间 -->
							<view class="store-detail-row">
								<uni-icons type="calendar" size="14" color="#999999" style="margin-right: 8rpx; margin-top: 2rpx;"></uni-icons>
								<text class="time-label">营业时间：</text>
								<text class="time-value">{{formatBusinessHours(item.business_hours)}}</text>
							</view>
						</view>

						<!-- 右侧操作栏 -->
						<view class="store-actions">
							<view class="action-btn" @click.stop="makePhoneCall(item.phone)">
								<uni-icons type="phone-filled" size="18" color="#666666"></uni-icons>
							</view>
							<view class="action-btn" @click.stop="openNavigation(item)">
								<uni-icons type="navigate-filled" size="18" color="#666666"></uni-icons>
							</view>
						</view>
					</view>

					<!-- 选中后的底部确认操作 -->
					<view v-if="selectedStoreId === item.id" class="card-bottom-action" @click.stop="selectStore(item)">
						<text class="order-btn-text">确认选择并点单</text>
					</view>
				</view>
				<view v-if="stores.length === 0 && !locationLoading" class="empty-state">
					<text class="empty-text">暂无门店数据</text>
				</view>
			</scroll-view>
		</view>
	</view>
</template>

<script setup lang="uts">
	import { ref, computed, onMounted } from 'vue'
	import { request } from '@/utils/request.uts'
	import { formatDistance, formatBusinessHours, isStoreOpen } from '@/utils/format.uts'
	import { debounce } from '@/utils/common.uts'
	import { useAppStore, StoreInfo } from '@/store/app.uts'
	import { useCartStore } from '@/store/cart.uts'

	const appStore = useAppStore()
	const cartStore = useCartStore()
	const stores = ref([] as StoreInfo[])

	// 地图相关状态
	const userLongitude = ref(0)
	const userLatitude = ref(0)
	const mapLongitude = ref(116.397428)
	const mapLatitude = ref(39.90923)
	const mapScale = ref(13)
	const selectedStoreId = ref(-1)
	const scrollToView = ref('')
	const hasLocation = ref(false)
	const locationLoading = ref(true)

	// 底部抽屉相关状态与手势逻辑
	const drawerState = ref('collapsed') // 'collapsed' | 'expanded'
	const startY = ref(0)
	const isDragging = ref(false)
	const scrollTop = ref(0)

	function onTouchStart(e : any) {
		const touches = e.touches as any[]
		if (touches.length > 0) {
			startY.value = touches[0].clientY as number
			isDragging.value = true
		}
	}

	function onTouchMove(e : any) {
		if (!isDragging.value) return
		const touches = e.touches as any[]
		if (touches.length > 0) {
			const clientY = touches[0].clientY as number
			const moveY = clientY - startY.value

			// 折叠状态下，往上拖动超过一定距离（30px），触发展开
			if (drawerState.value === 'collapsed' && moveY < -30) {
				drawerState.value = 'expanded'
				isDragging.value = false
			}

			// 展开状态下，如果列表回到最顶部（scrollTop <= 5），往下拖动超过一定距离（30px），触发折叠
			if (drawerState.value === 'expanded' && scrollTop.value <= 5 && moveY > 30) {
				drawerState.value = 'collapsed'
				isDragging.value = false
			}
		}
	}

	function onTouchEnd() {
		isDragging.value = false
	}

	function onScroll(e : any) {
		scrollTop.value = e.detail.scrollTop as number
	}

	// 5公里直径（2.5公里半径）的圆圈
	const mapCircles = computed(() => {
		const circles = [] as UTSJSONObject[]
		if (hasLocation.value) {
			circles.push({
				latitude: userLatitude.value,
				longitude: userLongitude.value,
				color: '#00cc9988', // 边框颜色
				fillColor: '#00cc991a', // 填充颜色（浅绿色半透明）
				radius: 2500, // 半径2.5公里，直径即5公里
				strokeWidth: 2
			} as UTSJSONObject)
		}
		return circles
	})

	// 构建地图标记
	const mapMarkers = computed(() => {
		const markers = [] as UTSJSONObject[]
		for (let i = 0; i < stores.value.length; i++) {
			const s = stores.value[i]
			if (s.longitude == null || s.latitude == null) continue

			markers.push({
				id: s.id,
				longitude: s.longitude,
				latitude: s.latitude,
				title: s.name,
				iconPath: '/static/images/icon.png',
				width: 36,
				height: 36,
				anchor: { x: 0.5, y: 1 } as UTSJSONObject,
				callout: {
					content: s.name,
					color: '#ffffff',
					fontSize: 11,
					borderRadius: 16,
					bgColor: '#00CC99',
					padding: 6,
					display: 'ALWAYS',
					textAlign: 'center'
				} as UTSJSONObject
			} as UTSJSONObject)
		}
		return markers
	})

	onMounted(() => {
		getNearbyStores()
	})

	// Haversine 公式计算两点间直线距离（单位：km）
	function haversineDistance(lat1 : number, lng1 : number, lat2 : number, lng2 : number) : number {
		const R = 6371.0
		const dLat = (lat2 - lat1) * Math.PI / 180
		const dLng = (lng2 - lng1) * Math.PI / 180
		const a = Math.sin(dLat / 2) * Math.sin(dLat / 2) +
			Math.cos(lat1 * Math.PI / 180) * Math.cos(lat2 * Math.PI / 180) *
			Math.sin(dLng / 2) * Math.sin(dLng / 2)
		const c = 2 * Math.atan2(Math.sqrt(a), Math.sqrt(1 - a))
		return R * c
	}

	// 为门店列表补充距离信息
	function applyDistance(list : StoreInfo[]) : StoreInfo[] {
		if (!hasLocation.value) return list
		for (let i = 0; i < list.length; i++) {
			const s = list[i]
			if (s.longitude != null && s.latitude != null) {
				s.distance = haversineDistance(
					userLatitude.value, userLongitude.value,
					s.latitude as number, s.longitude as number
				)
			}
		}
		// 按距离排序
		list.sort((a, b) => {
			const da = typeof a.distance === 'number' ? a.distance : 9999
			const db = typeof b.distance === 'number' ? b.distance : 9999
			return da - db
		})
		return list
	}

	// 多级定位策略：请求授权 → GPS精确定位 → 低精度网络定位 → 仅加载门店列表
	function getNearbyStores(keyword : string = '') {
		locationLoading.value = true

		// 第一步：请求定位授权（首次使用会弹出授权弹窗）
		uni.authorize({
			scope: 'scope.userLocation',
			success: () => {
				// 已授权，开始定位
				doGetLocation(keyword)
			},
			fail: () => {
				// 用户拒绝授权，提示去设置页开启
				locationLoading.value = false
				uni.showModal({
					title: '需要定位权限',
					content: '为了显示您附近的门店，请在设置中开启定位权限',
					confirmText: '去设置',
					cancelText: '取消',
					success: (res) => {
						if (res.confirm) {
							uni.openSetting({
								success: (settingRes) => {
									if (settingRes.authSetting['scope.userLocation']) {
										// 用户在设置页开启了权限，重新定位
										getNearbyStores(keyword)
									} else {
										getAllStores(keyword)
									}
								}
							})
						} else {
							getAllStores(keyword)
						}
					}
				})
			}
		})
	}

	// 执行定位（已有授权）
	function doGetLocation(keyword : string) {
		// 高精度GPS定位
		uni.getLocation({
			type: 'gcj02',
			success: (res) => {
				onLocationSuccess(res.longitude, res.latitude, keyword)
			},
			fail: (err) => {
				console.log('GPS定位失败，尝试低精度定位', err)
				// 降级：低精度网络定位
				uni.getLocation({
					type: 'gcj02',
					altitude: false,
					isHighAccuracy: false,
					success: (res) => {
						onLocationSuccess(res.longitude, res.latitude, keyword)
					},
					fail: (err2) => {
						console.log('低精度定位也失败', err2)
						locationLoading.value = false
						hasLocation.value = false
						getAllStores(keyword)
						uni.showToast({
							title: '定位失败，请手动选择门店',
							icon: 'none',
							duration: 2000
						})
					}
				})
			}
		})
	}

	// 定位成功回调
	function onLocationSuccess(lng : number, lat : number, keyword : string) {
		userLongitude.value = lng
		userLatitude.value = lat
		hasLocation.value = true
		
		// 加上微小的随机偏置，强制触发 Vue 的 reactivity 重新渲染，使拖动后的地图视口重新居中归位到用户当前位置
		mapLongitude.value = lng + (Math.random() - 0.5) * 0.000001
		mapLatitude.value = lat + (Math.random() - 0.5) * 0.000001

		// 请求附近门店（服务端已有 Haversine 距离计算）
		request<any>({
			url: '/store/nearby',
			data: {
				longitude: lng,
				latitude: lat,
				keyword: keyword
			}
		}).then(data => {
			const list = data.result.list as StoreInfo[]
			// 用前端 Haversine 校准距离，确保准确性
			stores.value = applyDistance(list)
			locationLoading.value = false
		}).catch(() => {
			locationLoading.value = false
		})
	}

	function getAllStores(keyword : string = '') {
		request<any>({
			url: '/store/all',
			data: { keyword: keyword }
		}).then(data => {
			const list = data.result.list as StoreInfo[]
			// 全量接口无距离字段，有定位时前端补充计算
			stores.value = applyDistance(list)
			// 无定位时，以第一个门店位置作为地图中心
			if (!hasLocation.value && list.length > 0 && list[0].longitude != null && list[0].latitude != null) {
				mapLongitude.value = list[0].longitude as number
				mapLatitude.value = list[0].latitude as number
			}
		})
	}

	// 重新定位
	function relocate() {
		selectedStoreId.value = -1
		stores.value = []
		getNearbyStores('')
	}

	// 点击地图标记 → 高亮门店并滚动到对应位置
	function onMarkerTap(e : any) {
		const markerId = e.detail.markerId as number
		selectedStoreId.value = markerId
		scrollToView.value = 'store-' + markerId
	}

	// 点击气泡 → 切换门店
	function onCalloutTap(e : any) {
		const markerId = e.detail.markerId as number
		const store = stores.value.find(s => s.id === markerId)
		if (store != null) {
			selectStore(store)
		}
	}

	// 拨打电话
	function makePhoneCall(phone : string | null) {
		if (phone == null || phone === '') {
			uni.showToast({ title: '该门店暂未提供电话', icon: 'none' })
			return
		}
		uni.makePhoneCall({
			phoneNumber: phone,
			fail: () => {
				console.log('拨号失败')
			}
		})
	}

	// 导航
	function openNavigation(store : StoreInfo) {
		console.log('开始导航到门店:', store)
		
		if (store.longitude == null || store.latitude == null) {
			uni.showToast({ title: '门店经纬度位置缺失，无法导航', icon: 'none' })
			return
		}
		
		// 显式解析为浮点数以保证类型完全正确，避免后端传入 String 格式导致底层原生组件解析失效
		let lat = 0.0
		let lng = 0.0
		
		if (typeof store.latitude === 'number') {
			lat = store.latitude as number
		} else {
			lat = parseFloat(store.latitude.toString())
		}
		
		if (typeof store.longitude === 'number') {
			lng = store.longitude as number
		} else {
			lng = parseFloat(store.longitude.toString())
		}
		
		if (isNaN(lat) || isNaN(lng) || lat === 0.0 || lng === 0.0) {
			uni.showToast({ title: '门店坐标无效，无法导航', icon: 'none' })
			return
		}

		const name = store.name
		const address = store.address

		let handled = false

		// #ifdef APP-PLUS
		handled = true
		const url = `androidamap://viewMap?sourceApplication=yonggetea&poiname=${name}&lat=${lat}&lon=${lng}&dev=0`
		const iosUrl = `iosamap://viewMap?sourceApplication=yonggetea&poiname=${name}&lat=${lat}&lon=${lng}&dev=0`
		
		if (uni.getSystemInfoSync().platform === 'ios') {
			plus.runtime.openURL(iosUrl, (err) => {
				uni.openLocation({
					longitude: lng,
					latitude: lat,
					name: name,
					address: address
				})
			})
		} else {
			plus.runtime.openURL(url, (err) => {
				uni.openLocation({
					longitude: lng,
					latitude: lat,
					name: name,
					address: address
				})
			})
		}
		// #endif

		if (!handled) {
			// 小程序、H5 平台使用 uni.openLocation，这是最安全且支持高德地图等多种地图应用拉起的方法
			uni.openLocation({
				longitude: lng,
				latitude: lat,
				name: name,
				address: address,
				fail: (err) => {
					console.error('uni.openLocation fail:', err)
					uni.showToast({ title: '打开导航失败', icon: 'none' })
				}
			})
		}
	}

	function selectStore(store : StoreInfo) {
		// 如果购物车为空，直接切换
		if (cartStore.items.length === 0) {
			appStore.setStore(store)
			uni.navigateBack()
			return
		}

		// 购物车不为空，提示用户
		uni.showModal({
			title: '切换门店',
			content: `切换到"${store.name}"后，购物车中部分商品可能不可用，是否继续？`,
			confirmText: '切换',
			cancelText: '取消',
			success: async (res) => {
				if (res.confirm) {
					uni.showLoading({ title: '正在检查商品...' })

					const result = await cartStore.transferCartToStore(store.id)

					uni.hideLoading()

					if (result.removed.length > 0) {
						const removedNames = result.removed.map(i => i.name).join('、')
						uni.showModal({
							title: '商品变动',
							content: `以下商品在"${store.name}"不可用，已从购物车移除：\n${removedNames}`,
							showCancel: false,
							confirmText: '知道了'
						})
					} else if (result.updated.length > 0) {
						uni.showToast({ title: '已切换门店', icon: 'success' })
					}

					appStore.setStore(store)
					uni.navigateBack()
				}
			}
		})
	}

	const debouncedSearch = debounce((keyword : string) => {
		getNearbyStores(keyword)
	}, 500)

	function onInput(e : any) {
		const keyword = e.value as string
		debouncedSearch(keyword)
	}

	function clearSearch() {
		getNearbyStores('')
	}

	function search(e : any) {
		const keyword = e.value as string
		getNearbyStores(keyword)
	}
</script>

<style>
	.container {
		background-color: #f5f5f5;
		height: 100vh;
		position: relative;
		overflow: hidden;
	}

	.search-bar {
		background-color: #ffffff;
		padding: 10rpx 0;
	}

	/* 地图容器 */
	.map-wrapper {
		width: 100%;
		height: calc(100vh - 100rpx - 33.3vh);
		overflow: hidden;
		border-radius: 0 0 32rpx 32rpx;
		position: relative;
	}

	.store-map {
		width: 100%;
		height: 100%;
	}

	/* 重新定位按钮 */
	.relocate-btn {
		position: absolute;
		right: 24rpx;
		bottom: 24rpx;
		background-color: #ffffff;
		border-radius: 32rpx;
		padding: 12rpx 24rpx;
		flex-direction: row;
		align-items: center;
		box-shadow: 0 2px 12px rgba(0, 0, 0, 0.1);
		z-index: 10;
		transition: transform 0.3s cubic-bezier(0.25, 0.8, 0.25, 1);
	}

	.relocate-btn-up {
		transform: translateY(-16.7vh);
	}


	.relocate-text {
		font-size: 22rpx;
		color: #333333;
	}

	/* 定位加载状态 */
	.location-loading {
		position: absolute;
		left: 24rpx;
		top: 24rpx;
		background-color: rgba(0, 0, 0, 0.6);
		border-radius: 24rpx;
		padding: 10rpx 24rpx;
	}

	.loading-text {
		font-size: 22rpx;
		color: #ffffff;
	}

	/* 底部抽屉容器 */
	.drawer-container {
		position: fixed;
		bottom: 0;
		left: 0;
		right: 0;
		height: 50vh; /* 屏幕的 1/2 */
		background-color: #f5f5f5;
		border-radius: 32rpx 32rpx 0 0;
		box-shadow: 0 -4px 16px rgba(0, 0, 0, 0.08);
		display: flex;
		flex-direction: column;
		overflow: hidden;
		z-index: 99;
		transition: transform 0.3s cubic-bezier(0.25, 0.8, 0.25, 1);
	}

	/* 折叠状态：向下平移 16.7vh，使其只露出 33.3vh (1/3) */
	.drawer-collapsed {
		transform: translateY(16.7vh);
	}

	/* 展开状态：完全显示 50vh (1/2) */
	.drawer-expanded {
		transform: translateY(0);
	}

	/* 门店列表 */
	.store-list {
		flex: 1;
		height: 0;
		background-color: #f5f5f5;
	}

	.card {
		background-color: #ffffff;
		margin: 10rpx 20rpx;
		padding: 30rpx;
		border-radius: 16rpx;
		border-left: 6rpx solid transparent;
	}

	.card-active {
		border-left-color: #00cc99;
		background-color: #f9fffe;
	}

	.store-main {
		flex-direction: row;
		justify-content: space-between;
	}

	.store-info {
		flex: 1;
	}

	.store-name-row {
		flex-direction: row;
		align-items: center;
		margin-bottom: 10rpx;
	}

	.store-name {
		font-size: 32rpx;
		font-weight: bold;
		color: #333333;
	}

	.current-tag {
		font-size: 20rpx;
		color: #ffffff;
