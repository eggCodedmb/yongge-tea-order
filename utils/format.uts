export function formatDistance(distance : any) : string {
	if (distance == null) return ''
	if (typeof distance === 'string' && distance.includes('m')) return distance
	
	const d = parseFloat(distance.toString())
	if (isNaN(d)) return distance.toString()
	
	if (d < 1) {
		return (d * 1000).toFixed(0) + 'm'
	}
	return d.toFixed(1) + 'km'
}
export function formatBusinessHours(hours : any) : string {
	if (hours == null || hours === '') return '08:00-22:00'
	if (typeof hours !== 'string') return hours.toString()
	
	try {
		if (hours.startsWith('[') && hours.endsWith(']')) {
			const arr = JSON.parse(hours)
			if (Array.isArray(arr)) {
				return arr.join(' ')
			}
		}
	} catch (e) {
		// 如果解析失败，直接返回原字符串
	}
	
	return hours
}

export function isStoreOpen(hours : any) : boolean {
	if (hours == null || hours === '') return true
	
	let hoursStr = ''
	if (typeof hours !== 'string') {
		hoursStr = hours.toString()
	} else {
		hoursStr = hours
	}

	const timeRanges = [] as string[]
	try {
		if (hoursStr.startsWith('[') && hoursStr.endsWith(']')) {
			const arr = JSON.parse(hoursStr)
			if (Array.isArray(arr)) {
				for (let i = 0; i < arr.length; i++) {
					const item = arr[i]
					if (item != null) {
						timeRanges.push(item.toString())
					}
				}
			}
		} else {
			timeRanges.push(hoursStr)
		}
	} catch (e) {
		timeRanges.push(hoursStr)
	}

	if (timeRanges.length === 0) {
		return true
	}

	const now = new Date()
	const currentHour = now.getHours()
	const currentMin = now.getMinutes()
	const currentTotalMin = currentHour * 60 + currentMin

	for (let i = 0; i < timeRanges.length; i++) {
		const range = timeRanges[i]
		const parts = range.split('-')
		if (parts.length === 2) {
			const startParts = parts[0].split(':')
			const endParts = parts[1].split(':')
			if (startParts.length === 2 && endParts.length === 2) {
				const startHour = parseInt(startParts[0], 10)
				const startMin = parseInt(startParts[1], 10)
				const endHour = parseInt(endParts[0], 10)
				const endMin = parseInt(endParts[1], 10)

				const startTotalMin = startHour * 60 + startMin
				const endTotalMin = endHour * 60 + endMin

				if (endTotalMin < startTotalMin) {
					// 跨天情况，例如 22:00-02:00
					if (currentTotalMin >= startTotalMin || currentTotalMin < endTotalMin) {
						return true
					}
				} else {
					if (currentTotalMin >= startTotalMin && currentTotalMin <= endTotalMin) {
						return true
					}
				}
			}
		}
	}

	return false
}